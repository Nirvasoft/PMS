  validFrom              DateTime  @map("valid_from") @db.Timestamptz
  validTo                DateTime  @map("valid_to") @db.Timestamptz
  // QR pass
  qrToken                String    @unique @map("qr_token") @db.VarChar(255)
  qrTokenHash            String    @unique @map("qr_token_hash") @db.VarChar(255)
  passType               String    @default("single") @map("pass_type") @db.VarChar(20)
                          // 'single'|'recurring'|'multi_day'
  maxUses                Int       @default(1) @map("max_uses") @db.SmallInt
  useCount               Int       @default(0) @map("use_count") @db.SmallInt
  // Status
  status                 String    @default("pending") @db.VarChar(20)
                          // 'pending'|'approved'|'checked_in'|'checked_out'|'expired'|'cancelled'|'denied'
  // Actual visit
  checkedInAt            DateTime? @map("checked_in_at") @db.Timestamptz
  checkedOutAt           DateTime? @map("checked_out_at") @db.Timestamptz
  checkInGate            String?   @map("check_in_gate") @db.VarChar(100)
  checkInGuardId         String?   @map("check_in_guard_id") @db.Uuid
  actualDurationMinutes  Int?      @map("actual_duration_minutes") @db.SmallInt
  // Overstay
  isOverstay             Boolean   @default(false) @map("is_overstay")
  overstayNotified       Boolean   @default(false) @map("overstay_notified")
  // Vehicle
  vehiclePlate           String?   @map("vehicle_plate") @db.VarChar(30)
  vehicleMake            String?   @map("vehicle_make") @db.VarChar(50)
  parkingSlotId          String?   @map("parking_slot_id") @db.Uuid
  // Misc
  notes                  String?   @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property               Property       @relation(fields: [propertyId], references: [id])
  hostUnit               Unit           @relation(fields: [hostUnitId], references: [id])
  hostResident           Resident?      @relation(fields: [hostResidentId], references: [id])
  hostUser               User?          @relation("VisitorHost", fields: [hostUserId], references: [id])
  checkInGuard           User?          @relation("VisitorCheckInGuard", fields: [checkInGuardId], references: [id])
  parkingSlot            ParkingSlot?   @relation("VisitorParkingSlot", fields: [parkingSlotId], references: [id])
  walkinApprovals        WalkinApproval[]

  @@index([propertyId, validFrom(sort: Desc)])
  @@index([hostUnitId])
  @@index([qrTokenHash])
  @@index([status])
  @@index([companyId])
  @@map("visitors")
}

