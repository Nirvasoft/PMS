model Visitor {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  propertyId             String    @map("property_id") @db.Uuid
  hostUnitId             String    @map("host_unit_id") @db.Uuid
  hostResidentId         String?   @map("host_resident_id") @db.Uuid
  hostUserId             String?   @map("host_user_id") @db.Uuid
  visitorName            String    @map("visitor_name") @db.VarChar(200)
  visitorIc              String?   @map("visitor_ic") @db.VarChar(50)
  visitorMobile          String?   @map("visitor_mobile") @db.VarChar(50)
  visitorCompany         String?   @map("visitor_company") @db.VarChar(150)
