  @@index([tenantId])
  @@map("payment_gateway_transactions")
}

// ─────────────────────────────────────────────
// MAINTENANCE MANAGEMENT (Module 4.1)
// ─────────────────────────────────────────────

model MaintenanceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid    // NULL = system-seeded
  name        String    @db.VarChar(150)
  description String?   @db.Text
  icon        String?   @db.VarChar(50)
  parentId    String?   @map("parent_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company     Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      MaintenanceCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    MaintenanceCategory[] @relation("CategoryTree")
  slaConfigs  MaintenanceSlaConfig[]
  tickets     MaintenanceTicket[]
  pmSchedules PmSchedule[]

  @@index([companyId])
  @@map("maintenance_categories")
}

model MaintenanceSlaConfig {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  propertyId          String?   @map("property_id") @db.Uuid
  categoryId          String?   @map("category_id") @db.Uuid
  priority            String    @db.VarChar(10)
                                // 'P1'|'P2'|'P3'|'P4'
  responseHours       Int       @map("response_hours") @db.SmallInt
  resolutionHours     Int       @map("resolution_hours") @db.SmallInt
  workingHoursOnly    Boolean   @default(false) @map("working_hours_only")
  escalationContactId String?   @map("escalation_contact_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category            MaintenanceCategory? @relation(fields: [categoryId], references: [id])
  escalationContact   User?                @relation("SlaEscalationContact", fields: [escalationContactId], references: [id])

  @@index([companyId])
  @@map("maintenance_sla_configs")
}

model MaintenanceTicket {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  propertyId          String    @map("property_id") @db.Uuid
  unitId              String?   @map("unit_id") @db.Uuid
  ticketNumber        String    @unique @map("ticket_number") @db.VarChar(30)
  title               String    @db.VarChar(500)
  description         String?   @db.Text
  categoryId          String    @map("category_id") @db.Uuid
  priority            String    @default("P3") @db.VarChar(10)
  status              String    @default("open") @db.VarChar(30)
                                // 'open'|'assigned'|'in_progress'|'pending_parts'
                                // |'completed'|'closed'|'cancelled'|'reopened'
  source              String    @default("staff") @db.VarChar(20)
                                // 'tenant'|'staff'|'preventive'|'inspection'|'system'
  reportedByTenantId  String?   @map("reported_by_tenant") @db.Uuid
  reportedByUserId    String?   @map("reported_by_user") @db.Uuid
  assignedToId        String?   @map("assigned_to") @db.Uuid
  assignedAt          DateTime? @map("assigned_at") @db.Timestamptz
  // SLA tracking
  slaResponseDueAt    DateTime? @map("sla_response_due_at") @db.Timestamptz
  slaResolveDueAt     DateTime? @map("sla_resolve_due_at") @db.Timestamptz
  slaResponseMet      Boolean?  @map("sla_response_met")
  slaResolveMet       Boolean?  @map("sla_resolve_met")
  firstResponseAt     DateTime? @map("first_response_at") @db.Timestamptz
  // Escalation
  escalationLevel     Int       @default(0) @map("escalation_level") @db.SmallInt
  escalatedAt         DateTime? @map("escalated_at") @db.Timestamptz
  escalatedToId       String?   @map("escalated_to") @db.Uuid
  // Resolution
  resolutionNotes     String?   @map("resolution_notes") @db.Text
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz
  resolvedById        String?   @map("resolved_by") @db.Uuid
  // Tenant feedback
  rating              Int?      @db.SmallInt
  ratingComment       String?   @map("rating_comment") @db.Text
  ratedAt             DateTime? @map("rated_at") @db.Timestamptz
  // Costs
  estimatedCost       Decimal?  @map("estimated_cost") @db.Decimal(12, 2)
  actualCost          Decimal?  @map("actual_cost") @db.Decimal(12, 2)
  // Metadata
  locationDetail      String?   @map("location_detail") @db.VarChar(255)
  isUrgent            Boolean   @default(false) @map("is_urgent")
  requiresAccess      Boolean   @default(true) @map("requires_access")
  accessGranted       Boolean?  @map("access_granted")
  accessTime          DateTime? @map("access_time") @db.Timestamptz
  workflowInstanceId  String?   @map("workflow_instance_id") @db.Uuid
  glPosted            Boolean   @default(false) @map("gl_posted")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property            Property             @relation(fields: [propertyId], references: [id])
  unit                Unit?                @relation(fields: [unitId], references: [id])
  category            MaintenanceCategory  @relation(fields: [categoryId], references: [id])
  reportedByTenant    Tenant?              @relation("TicketReportedByTenant", fields: [reportedByTenantId], references: [id])
  reportedByUser      User?                @relation("TicketReportedByUser", fields: [reportedByUserId], references: [id])
  assignedTo          User?                @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  escalatedTo         User?                @relation("TicketEscalatedTo", fields: [escalatedToId], references: [id])
  resolvedBy          User?                @relation("TicketResolvedBy", fields: [resolvedById], references: [id])
  photos              TicketPhoto[]
  workOrders          WorkOrder[]
  slaBreachEvents     SlaBreachEvent[]
  pmWorkOrders        PmWorkOrder[]
  housekeepingInspections HousekeepingInspection[]

  @@index([companyId])
  @@index([propertyId])
  @@index([status])
  @@index([assignedToId])
  @@index([slaResolveDueAt])
  @@map("maintenance_tickets")
}

model TicketPhoto {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  ticketId    String    @map("ticket_id") @db.Uuid
  workOrderId String?   @map("work_order_id") @db.Uuid
  storageKey  String    @map("storage_key") @db.VarChar(1000)
  url         String    @db.VarChar(500)
  photoType   String    @default("before") @map("photo_type") @db.VarChar(10)
                        // 'before'|'during'|'after'
  caption     String?   @db.VarChar(255)
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
