  @@map("parking_zones")
}

model ParkingSlot {
  id              String    @id @default(uuid()) @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  zoneId          String?   @map("zone_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
