// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ORGANIZATION (minimal for auth FK)
// ─────────────────────────────────────────────

model Company {
  id              String    @id @default(uuid()) @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  name            String    @db.VarChar(255)
  legalName       String?   @map("legal_name") @db.VarChar(255)
  companyType     String    @default("standalone") @map("company_type") @db.VarChar(30)
  registrationNo  String?   @map("registration_no") @db.VarChar(100)
  taxId           String?   @map("tax_id") @db.VarChar(100)
  industry        String?   @db.VarChar(100)
  phone           String?   @db.VarChar(50)
  email           String?   @db.VarChar(255)
  website         String?   @db.VarChar(255)
  addressLine1    String?   @map("address_line1") @db.VarChar(255)
  addressLine2    String?   @map("address_line2") @db.VarChar(255)
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  postalCode      String?   @map("postal_code") @db.VarChar(20)
  country         String    @default("US") @db.VarChar(2)
  timezone        String?   @default("UTC") @db.VarChar(60)
  currency        String?   @default("USD") @db.VarChar(3)
  logoUrl         String?   @map("logo_url") @db.VarChar(500)
  isActive        Boolean   @default(true) @map("is_active")
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  parent          Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries    Company[] @relation("CompanyHierarchy")
  users           User[]
  passwordPolicies PasswordPolicy[]
  ipPolicies      IpPolicy[]
  authAuditLogs   AuthAuditLog[]
  departments     Department[]
  positions       Position[]
  roles           Role[]
  userInvitations UserInvitation[]

  // Relations — Organization (Module 1.3)
  branches        Branch[]
  regions         Region[]
  businessUnits   BusinessUnit[]
  properties      Property[]

  // Relations — Workflow (Module 1.4)
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]

  // Relations — Notifications (Module 1.5)
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  inAppNotifications    InAppNotification[]

  // Relations — SSO
  ssoConfigs          SsoConfig[]

  // Relations — Documents (Module 1.6)
  documentFolders     DocumentFolder[]
  documents           Document[]

  // Relations — Dashboard (Module 1.7)
  savedReports        SavedReport[]

  @@index([parentId])
  @@map("companies")
}

// ─────────────────────────────────────────────
// AUTH SCHEMA
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  email               String    @db.VarChar(255)
  emailVerified       Boolean   @default(false) @map("email_verified")
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  isLocked            Boolean   @default(false) @map("is_locked")
  lockedAt            DateTime? @map("locked_at") @db.Timestamptz
  lockedReason        String?   @map("locked_reason") @db.VarChar(255)
  failedAttempts      Int       @default(0) @map("failed_attempts") @db.SmallInt
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes      String[]  @map("mfa_backup_codes")
  passwordChangedAt   DateTime? @default(now()) @map("password_changed_at") @db.Timestamptz
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  // Relations — Auth (Module 1.1)
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  devices             UserDevice[]
  passwordHistory     PasswordHistory[]
  authAuditLogs       AuthAuditLog[]        @relation("UserAuditLogs")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  createdIpPolicies   IpPolicy[]            @relation("IpPolicyCreator")
  userIpPolicies      IpPolicy[]            @relation("IpPolicyUser")

  // Relations — User & Role (Module 1.2)
  profile             UserProfile?
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[] @relation("UserOverrides")
  grantedOverrides    UserPermissionOverride[] @relation("OverrideGrantor")
  managedDepartments  Department[]            @relation("DepartmentManager")
  createdRoles        Role[]                  @relation("RoleCreator")
  grantedRolePerms    RolePermission[]        @relation("RolePermGrantor")
  grantedUserRoles    UserRole[]              @relation("UserRoleGrantor")
  sentInvitations     UserInvitation[]        @relation("InvitationSender")

  // Relations — Organization (Module 1.3)
  managedBranches     Branch[]                @relation("BranchManager")
  managedRegions      Region[]                @relation("RegionManager")
  managedBusinessUnits BusinessUnit[]          @relation("BusinessUnitManager")

  // Relations — Workflow (Module 1.4)
  createdDefinitions  WorkflowDefinition[]    @relation("WfDefinitionCreator")
  initiatedInstances  WorkflowInstance[]      @relation("WfInstanceInitiator")
  assignedTasks       WorkflowTask[]          @relation("WfTaskAssignee")
  delegatedTasks      WorkflowTask[]          @relation("WfTaskDelegatee")
  completedTasks      WorkflowTask[]          @relation("WfTaskCompleter")
  wfHistoryActions    WorkflowHistory[]       @relation("WfHistoryPerformer")

  // Relations — Notifications (Module 1.5)
  notificationLogs       NotificationLog[]       @relation("NotificationRecipient")
  inAppNotifications     InAppNotification[]     @relation("InAppNotifications")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferences")

  // Relations — SSO
  ssoIdentities          SsoIdentity[]           @relation("UserSsoIdentities")

  // Relations — Documents (Module 1.6)
  uploadedDocuments      Document[]              @relation("DocumentUploader")
  uploadedVersions       DocumentVersion[]       @relation("VersionUploader")
  documentAccessLogs     DocumentAccessLog[]     @relation("DocumentAccessor")
  documentShares         DocumentShare[]         @relation("ShareCreator")

  // Relations — Dashboard (Module 1.7)
  dashboardLayouts       DashboardLayout[]       @relation("UserDashboardLayouts")
  savedReports           SavedReport[]           @relation("ReportCreator")

  @@unique([email, companyId], name: "uq_users_email_company")
  @@index([email])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  family       String    @db.VarChar(255)
  deviceId     String?   @map("device_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason") @db.VarChar(100)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([family])
  @@map("refresh_tokens")
}

model UserDevice {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceName   String?   @map("device_name") @db.VarChar(255)
  deviceType   String?   @map("device_type") @db.VarChar(50)
  os           String?   @db.VarChar(100)
  browser      String?   @db.VarChar(100)
  fingerprint  String    @db.VarChar(255)
  isTrusted    Boolean   @default(false) @map("is_trusted")
  trustedAt    DateTime? @map("trusted_at") @db.Timestamptz
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz
  lastIp       String?   @map("last_ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fingerprint, userId], name: "uq_device_fingerprint_user")
  @@map("user_devices")
}

model IpPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  policyType  String   @map("policy_type") @db.VarChar(10)
  cidr        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?    @relation("IpPolicyUser", fields: [userId], references: [id], onDelete: Cascade)
  creator     User?    @relation("IpPolicyCreator", fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("ip_policies")
}

model PasswordPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @unique @map("company_id") @db.Uuid
  minLength            Int      @default(8) @map("min_length") @db.SmallInt
  requireUppercase     Boolean  @default(true) @map("require_uppercase")
  requireLowercase     Boolean  @default(true) @map("require_lowercase")
  requireNumber        Boolean  @default(true) @map("require_number")
  requireSpecial       Boolean  @default(true) @map("require_special")
  maxAgeDays           Int?     @default(90) @map("max_age_days") @db.SmallInt
  historyCount         Int      @default(5) @map("history_count") @db.SmallInt
  maxFailedAttempts    Int      @default(5) @map("max_failed_attempts") @db.SmallInt
  lockoutDurationMins  Int      @default(30) @map("lockout_duration_mins") @db.SmallInt
  sessionTimeoutMins   Int      @default(480) @map("session_timeout_mins") @db.SmallInt
  mfaRequired          Boolean  @default(false) @map("mfa_required")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("password_policies")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model AuthAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  email       String?  @db.VarChar(255)
  companyId   String?  @map("company_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(50)
  status      String   @db.VarChar(10)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  deviceId    String?  @map("device_id") @db.Uuid
  geoCountry  String?  @map("geo_country") @db.VarChar(100)
  geoCity     String?  @map("geo_city") @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user        User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("auth_audit_logs")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  ipAddress String?   @map("ip_address") @db.VarChar(45)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// MODULE 1.2 — USER & ROLE MANAGEMENT
// ─────────────────────────────────────────────

model UserProfile {
  userId        String    @id @map("user_id") @db.Uuid
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  phone         String?   @db.VarChar(30)
  mobile        String?   @db.VarChar(30)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  jobTitle      String?   @map("job_title") @db.VarChar(150)
  departmentId  String?   @map("department_id") @db.Uuid
  positionId    String?   @map("position_id") @db.Uuid
  employeeId    String?   @map("employee_id") @db.VarChar(50)
  dateOfJoining DateTime? @map("date_of_joining") @db.Date
  notes         String?   @db.Text
  timezone      String    @default("UTC") @db.VarChar(60)
  locale        String    @default("en") @db.VarChar(10)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position      Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model Department {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  name       String    @db.VarChar(150)
  code       String?   @db.VarChar(50)
  managerId  String?   @map("manager_id") @db.Uuid
  isActive   Boolean   @default(true) @map("is_active")
  sortOrder  Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent     Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Department[] @relation("DepartmentHierarchy")
  manager    User?      @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  positions  Position[]
  profiles   UserProfile[]

  @@unique([code, companyId], name: "uq_dept_code_company")
  @@index([companyId])
  @@index([parentId])
  @@map("departments")
}

model Position {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  departmentId  String?   @map("department_id") @db.Uuid
  name          String    @db.VarChar(150)
  level         Int       @default(1) @db.SmallInt
  canApprove    Boolean   @default(false) @map("can_approve")
  approvalLimit Decimal?  @map("approval_limit") @db.Decimal(15, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  profiles      UserProfile[]

  @@map("positions")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator         User?            @relation("RoleCreator", fields: [createdBy], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  invitations     UserInvitation[]

  @@unique([name, companyId], name: "uq_role_name_company")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantor      User?      @relation("RolePermGrantor", fields: [grantedBy], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantor    User?     @relation("UserRoleGrantor", fields: [grantedBy], references: [id])

  @@unique([userId, roleId], name: "uq_user_role")
  @@index([userId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  overrideType String    @map("override_type") @db.VarChar(6)
  reason       String?   @db.Text
  grantedBy    String    @map("granted_by") @db.Uuid
  grantedAt    DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz

  user         User       @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantor      User       @relation("OverrideGrantor", fields: [grantedBy], references: [id])

  @@unique([userId, permissionId], name: "uq_user_perm_override")
  @@map("user_permission_overrides")
}

model RoleTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  description  String?  @db.Text
  permissions  String[]

  @@map("role_templates")
}

model UserInvitation {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  email        String    @db.VarChar(255)
  roleId       String?   @map("role_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  invitedBy    String    @map("invited_by") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  message      String?   @db.Text
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role         Role?     @relation(fields: [roleId], references: [id])
  inviter      User      @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@unique([companyId, email], name: "uq_active_invite")
  @@map("user_invitations")
}

// ─────────────────────────────────────────────
// MODULE 1.3 — ORGANIZATION MANAGEMENT
// ─────────────────────────────────────────────

model Branch {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String    @db.VarChar(255)
  code          String?   @db.VarChar(50)
  managerId     String?   @map("manager_id") @db.Uuid
  phone         String?   @db.VarChar(50)
  email         String?   @db.VarChar(255)
  addressLine1  String?   @map("address_line1") @db.VarChar(255)
  addressLine2  String?   @map("address_line2") @db.VarChar(255)
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  postalCode    String?   @map("postal_code") @db.VarChar(20)
  country       String    @default("US") @db.VarChar(2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager       User?     @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  properties    Property[]
  businessUnits BusinessUnit[]

  @@unique([code, companyId], name: "uq_branch_code_company")
  @@index([companyId])
  @@map("branches")
}

model Region {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @db.VarChar(150)
  code        String?   @db.VarChar(50)
  description String?   @db.Text
  managerId   String?   @map("manager_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager     User?     @relation("RegionManager", fields: [managerId], references: [id], onDelete: SetNull)
  regionProperties RegionProperty[]

  @@unique([code, companyId], name: "uq_region_code_company")
  @@map("regions")
}

model BusinessUnit {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
