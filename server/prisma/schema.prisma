  bankName        String    @db.VarChar(100)
  accountName     String    @db.VarChar(200)
  accountNumber   String    @db.VarChar(50)
  accountType     String    @default("current") @db.VarChar(20)
  currency        String    @default("USD") @db.VarChar(3)
  openingBalance  Decimal   @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal   @default(0) @db.Decimal(15, 2)
  swiftCode       String?   @db.VarChar(20)
  iban            String?   @db.VarChar(50)
  branchName      String?   @db.VarChar(100)
  branchCode      String?   @db.VarChar(20)
  glAccountId     String?   @db.Uuid
