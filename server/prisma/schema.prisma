// ─────────────────────────────────────────────
// SSO — SINGLE SIGN-ON (FUTURE-READY)
// ─────────────────────────────────────────────

/// Stores SSO/IdP configuration per company.
/// Supports OIDC (Azure AD, Okta, Google Workspace) and SAML.
model SsoConfig {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  name              String    @db.VarChar(255)        // "Acme Azure AD"
  provider          String    @db.VarChar(50)         // oidc | saml | azure_ad | okta | google
  protocol          String    @default("oidc") @db.VarChar(10) // oidc | saml
  isEnabled         Boolean   @default(false) @map("is_enabled")
  isDefault         Boolean   @default(false) @map("is_default")

  // OIDC fields
  clientId          String?   @map("client_id") @db.VarChar(255)
  clientSecret      String?   @map("client_secret") @db.VarChar(500) // encrypted at rest
  issuerUrl         String?   @map("issuer_url") @db.VarChar(500)    // e.g. https://login.microsoftonline.com/{tenant}/v2.0
  authorizationUrl  String?   @map("authorization_url") @db.VarChar(500)
  tokenUrl          String?   @map("token_url") @db.VarChar(500)
  userInfoUrl       String?   @map("userinfo_url") @db.VarChar(500)
  scopes            String    @default("openid profile email") @db.VarChar(500)

  // SAML fields (future)
  entityId          String?   @map("entity_id") @db.VarChar(500)
  ssoUrl            String?   @map("sso_url") @db.VarChar(500)
  certificate       String?   @db.Text

  // Mapping & provisioning
  autoProvision     Boolean   @default(false) @map("auto_provision")  // JIT user creation
  defaultRoleId     String?   @map("default_role_id") @db.Uuid       // Role for JIT-provisioned users
  domainRestriction String?   @map("domain_restriction") @db.VarChar(255) // e.g. "acme.com"
  attributeMapping  Json      @default("{}") @map("attribute_mapping") // Map IdP claims → PMS fields
  settings          Json      @default("{}")                          // Extra provider-specific config

  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  identities        SsoIdentity[]

  @@unique([companyId, provider], name: "uq_sso_company_provider")
  @@map("sso_configs")
}

/// Links an external IdP identity to a PMS user.
/// One user can have multiple SSO identities (e.g. Azure AD + Google).
model SsoIdentity {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  ssoConfigId       String    @map("sso_config_id") @db.Uuid
  externalId        String    @map("external_id") @db.VarChar(255) // sub / nameId from IdP
  externalEmail     String?   @map("external_email") @db.VarChar(255)
  externalUsername  String?   @map("external_username") @db.VarChar(255)
  rawAttributes     Json      @default("{}") @map("raw_attributes") // Full IdP profile snapshot
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user              User      @relation("UserSsoIdentities", fields: [userId], references: [id], onDelete: Cascade)
  ssoConfig         SsoConfig @relation(fields: [ssoConfigId], references: [id], onDelete: Cascade)

  @@unique([ssoConfigId, externalId], name: "uq_sso_identity")
  @@index([userId])
  @@map("sso_identities")
}

