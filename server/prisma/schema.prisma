  @@index([importId])
  @@index([matchStatus])
  @@map("bank_statement_lines")
}

model PaymentGatewayTransaction {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  propertyId      String?   @map("property_id") @db.Uuid
  gateway         String    @db.VarChar(30)
                            // 'stripe' | 'paytabs' | 'paypal'
  gatewayTxnId    String    @unique @map("gateway_txn_id") @db.VarChar(255)
  gatewayStatus   String    @map("gateway_status") @db.VarChar(30)
                            // 'initiated' | 'completed' | 'failed' | 'refunded'
  amount          Decimal   @db.Decimal(15, 2)
  currency        String    @db.VarChar(3)
  feeAmount       Decimal   @default(0) @map("fee_amount") @db.Decimal(15, 2)
  netAmount       Decimal?  @map("net_amount") @db.Decimal(15, 2)
  paymentMethod   String?   @map("payment_method") @db.VarChar(30)
                            // 'card' | 'bank' | 'wallet'
  payerEmail      String?   @map("payer_email") @db.VarChar(255)
  payerName       String?   @map("payer_name") @db.VarChar(200)
  tenantId        String?   @map("tenant_id") @db.Uuid
  invoiceId       String?   @map("invoice_id") @db.Uuid
  receiptId       String?   @map("receipt_id") @db.Uuid
  metadata        Json?     @default("{}")
  initiatedAt     DateTime  @default(now()) @map("initiated_at") @db.Timestamptz()
  completedAt     DateTime? @map("completed_at") @db.Timestamptz()
