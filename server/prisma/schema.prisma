  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_contacts")
}

model PropertyStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  fromStatus  String?  @map("from_status") @db.VarChar(30)
  toStatus    String   @map("to_status") @db.VarChar(30)
  reason      String?  @db.Text
  changedBy   String   @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  changedByUser User   @relation("StatusChanger", fields: [changedBy], references: [id])

  @@index([propertyId])
  @@map("property_status_history")
}

// ─────────────────────────────────────────────
// MODULE 2.2 — TOWER, BLOCK & UNIT MANAGEMENT
// ─────────────────────────────────────────────

model Tower {
  id           String         @id @default(uuid()) @db.Uuid
  propertyId   String         @map("property_id") @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  name         String         @db.VarChar(150)
  code         String?        @db.VarChar(50)
  description  String?        @db.Text
  totalFloors  Int?           @map("total_floors") @db.SmallInt
  yearBuilt    Int?           @map("year_built") @db.SmallInt
  isActive     Boolean        @default(true) @map("is_active")
  sortOrder    Int            @default(0) @map("sort_order") @db.SmallInt
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sections     TowerSection[]
  units        Unit[]

  @@unique([code, propertyId], name: "uq_tower_code_property")
  @@index([propertyId])
  @@map("towers")
}

model TowerSection {
  id         String   @id @default(uuid()) @db.Uuid
  towerId    String   @map("tower_id") @db.Uuid
  name       String   @db.VarChar(100)
  code       String?  @db.VarChar(20)
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt

  tower      Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  units      Unit[]

  @@index([towerId])
  @@map("tower_sections")
}

model UnitType {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  category    String  @db.VarChar(30)   // 'residential' | 'commercial' | 'storage' | 'parking'
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  units       Unit[]

  @@map("unit_types")
}

model Unit {
  id                 String         @id @default(uuid()) @db.Uuid
  propertyId         String         @map("property_id") @db.Uuid
  towerId            String?        @map("tower_id") @db.Uuid
  sectionId          String?        @map("section_id") @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  unitNumber         String         @map("unit_number") @db.VarChar(50)
  unitTypeId         String?        @map("unit_type_id") @db.Uuid
  unitType           String         @map("unit_type") @db.VarChar(50)
  floorNumber        Int?           @map("floor_number") @db.SmallInt
  floorLabel         String?        @map("floor_label") @db.VarChar(20)
  areaSqft           Decimal?       @map("area_sqft") @db.Decimal(10, 2)
  areaSqm            Decimal?       @map("area_sqm") @db.Decimal(10, 2)
  bedroomCount       Int            @default(0) @map("bedroom_count") @db.SmallInt
  bathroomCount      Int            @default(0) @map("bathroom_count") @db.SmallInt
  direction          String?        @db.VarChar(20)  // 'north' | 'south' | 'east' | 'west' | 'corner'
  floorPlanUrl       String?        @map("floor_plan_url") @db.VarChar(500)
  status             String         @default("available") @db.VarChar(30)
  ownershipType      String         @default("leasehold") @map("ownership_type") @db.VarChar(30)
  ownerName          String?        @map("owner_name") @db.VarChar(255)
  ownerContact       String?        @map("owner_contact") @db.VarChar(255)
  purchaseDate       DateTime?      @map("purchase_date") @db.Date
  purchasePrice      Decimal?       @map("purchase_price") @db.Decimal(15, 2)
  currentMarketValue Decimal?       @map("current_market_value") @db.Decimal(15, 2)
  furnishing         String         @default("unfurnished") @db.VarChar(20)
  rentalPeriod       Int            @default(1) @map("rental_period")
  rentalPeriodUnit   String         @default("month") @map("rental_period_unit") @db.VarChar(10)
  calculationOn      String         @default("fixed") @map("calculation_on") @db.VarChar(20)
  rate               Decimal?       @db.Decimal(15, 2)
  description        String?        @db.Text
  notes              String?        @db.Text
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz

  property           Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tower              Tower?         @relation(fields: [towerId], references: [id], onDelete: SetNull)
  section            TowerSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  unitTypeRef        UnitType?      @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  statusHistory      UnitStatusHistory[]
  meters             UtilityMeter[]
  amenities          UnitAmenity[]

  // Relations — Leases (Module 2.4)
  leases             Lease[]
  amendmentUnits     LeaseAmendment[] @relation("AmendmentUnit")

  // Relations — CRM (Module 2.5)
  leadViewings       LeadViewing[]   @relation("ViewingUnit")

  // Relations — Parking (Module 2.6)
  parkingAllocations ParkingAllocation[] @relation("AllocationUnit")
  visitorParkingPasses VisitorParkingPass[] @relation("PassUnit")

  // Relations — Billing (Module 3.1)
  billingSchedules BillingSchedule[] @relation("ScheduleUnit")
  invoices         Invoice[]         @relation("InvoiceUnit")

  // Relations — Maintenance (Module 4.1)
  maintenanceTickets MaintenanceTicket[]

  // Relations — Facility (Module 4.3)
  facilityAssets       FacilityAsset[]
  securityIncidents    SecurityIncident[]

  // Relations — Portal (Module 5.1)
  residents            Resident[]

  // Relations — Visitors/Booking/Community (Module 5.2-5.4)
  visitors             Visitor[]
  facilityBookings     FacilityBooking[]
  communityComplaints  CommunityComplaint[]
  moveRequests         MoveRequest[]

  // Relations — Mall (Module 6.1)
  shopProfile          ShopProfile?
  gtoSubmissions       GtoSubmission[]
  camBillings          CamBilling[]
  camReconciliations   CamReconciliation[]

  // Relations — Condo (Module 6.2)
  smartMeterReadings   SmartMeterReading[] @relation("ReadingUnit")
  fundTransactions     FundTransaction[]   @relation("FundTxnUnit")
  meetingProxies       MeetingProxy[]
  meetingVotes         MeetingVote[]       @relation("VoteUnit")
  bylawViolations      BylawViolation[]    @relation("ViolationUnit")

  @@unique([unitNumber, propertyId], name: "uq_unit_number_property")
  @@index([propertyId])
  @@index([towerId])
  @@index([status])
  @@index([unitType])
  @@map("units")
}

model UnitStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  fromStatus  String?  @map("from_status") @db.VarChar(30)
  toStatus    String   @map("to_status") @db.VarChar(30)
  reason      String?  @db.Text
  changedBy   String   @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz

  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changedByUser User   @relation("UnitStatusChanger", fields: [changedBy], references: [id])

  @@index([unitId])
  @@map("unit_status_history")
}

model UtilityMeter {
  id               String   @id @default(uuid()) @db.Uuid
  unitId           String   @map("unit_id") @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  meterType        String   @map("meter_type") @db.VarChar(20)  // 'electricity'|'water'|'gas'|'chilled_water'
  meterSerialNo    String   @map("meter_serial_no") @db.VarChar(100)
  meterProvider    String?  @map("meter_provider") @db.VarChar(100)
  location         String?  @db.VarChar(255)
  lastReading      Decimal? @map("last_reading") @db.Decimal(12, 3)
  lastReadingDate  DateTime? @map("last_reading_date") @db.Date
  isSmartMeter     Boolean  @default(false) @map("is_smart_meter")
  smartMeterId     String?  @map("smart_meter_id") @db.VarChar(100)
  isActive         Boolean  @default(true) @map("is_active")
  installedAt      DateTime? @map("installed_at") @db.Date
  ratePerUnit      Decimal?  @map("rate_per_unit") @db.Decimal(10, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  unit             Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([meterSerialNo, propertyId], name: "uq_meter_serial_property")
  @@index([unitId])
  @@index([propertyId])
  // Relations — Condo (Module 6.2)
  smartMeterReadings SmartMeterReading[]
  smartMeterDevice   SmartMeterDevice?

  @@map("utility_meters")
}

model UnitAmenity {
  id      String  @id @default(uuid()) @db.Uuid
  unitId  String  @map("unit_id") @db.Uuid
  amenity String  @db.VarChar(100)
  notes   String? @db.VarChar(255)

  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("unit_amenities")
}

// ─────────────────────────────────────────────
// MODULE 2.3 — TENANT MANAGEMENT (Phase 2)
// ─────────────────────────────────────────────

model Tenant {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  tenantType           String    @default("individual") @map("tenant_type") @db.VarChar(20) // 'individual' | 'company'

  // Individual fields
  firstName            String?   @map("first_name") @db.VarChar(100)
  lastName             String?   @map("last_name") @db.VarChar(100)
  fatherName           String?   @map("father_name") @db.VarChar(100)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  gender               String?   @db.VarChar(10)
  nationality          String?   @db.VarChar(100)
  idType               String?   @map("id_type") @db.VarChar(30)  // 'passport'|'nric'|'fin'|'driving_license'
  idNumber             String?   @map("id_number") @db.VarChar(100)
  idExpiryDate         DateTime? @map("id_expiry_date") @db.Date
  fatherNrc            String?   @map("father_nrc") @db.VarChar(50)

  // Company fields
  companyName          String?   @map("company_name") @db.VarChar(255)
  companyRegNo         String?   @map("company_reg_no") @db.VarChar(100)
  companyType          String?   @map("company_type") @db.VarChar(50) // 'private_limited'|'partnership'|'sole_prop'|'public'
  gstRegNo             String?   @map("gst_reg_no") @db.VarChar(50)

  // Common contact
  email                String?   @db.VarChar(255)
  phone                String?   @db.VarChar(50)
  mobile               String?   @db.VarChar(50)
  addressLine1         String?   @map("address_line1") @db.VarChar(255)
  addressLine2         String?   @map("address_line2") @db.VarChar(255)
  city                 String?   @db.VarChar(100)
  state                String?   @db.VarChar(100)
  postalCode           String?   @map("postal_code") @db.VarChar(20)
  country              String?   @db.VarChar(2)

  // Contact person (for company tenants)
  contactPersonName    String?   @map("contact_person_name") @db.VarChar(200)
  contactPersonPhone   String?   @map("contact_person_phone") @db.VarChar(50)
  contactPersonEmail   String?   @map("contact_person_email") @db.VarChar(255)
  contactPersonRole    String?   @map("contact_person_role") @db.VarChar(100)

  // KYC
  kycStatus            String    @default("pending") @map("kyc_status") @db.VarChar(20) // 'pending'|'in_review'|'verified'|'rejected'|'expired'
  kycVerifiedAt        DateTime? @map("kyc_verified_at") @db.Timestamptz
  kycVerifiedBy        String?   @map("kyc_verified_by") @db.Uuid
  kycExpiryDate        DateTime? @map("kyc_expiry_date") @db.Date

  // Blacklist
  isBlacklisted        Boolean   @default(false) @map("is_blacklisted")
  blacklistedAt        DateTime? @map("blacklisted_at") @db.Timestamptz
  blacklistedBy        String?   @map("blacklisted_by") @db.Uuid

  // Meta
  avatarUrl            String?   @map("avatar_url") @db.VarChar(500)
  notes                String?   @db.Text
  tags                 String[]  @default([])
  source               String?   @db.VarChar(50) // 'walk_in'|'referral'|'online'|'agent'
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kycVerifier          User?     @relation("KycVerifier", fields: [kycVerifiedBy], references: [id])
  blacklister          User?     @relation("TenantBlacklister", fields: [blacklistedBy], references: [id])
  kycDocuments         TenantKycDocument[]
  emergencyContacts    TenantEmergencyContact[]
  blacklistLog         TenantBlacklistLog[]
  tenantNotes          TenantNote[]

  // Relations — Leases (Module 2.4)
  leases               Lease[]

  // Relations — CRM (Module 2.5)
  convertedLeads       Lead[]          @relation("ConvertedTenant")

  // Relations — Parking (Module 2.6)
  parkingAllocations   ParkingAllocation[] @relation("AllocationTenant")
  tenantVehicles       TenantVehicle[]

  // Relations — Billing (Module 3.1)
  billingSchedules     BillingSchedule[] @relation("ScheduleTenant")
  invoices             Invoice[]         @relation("InvoiceTenant")

  // Relations — AR (Module 3.2)
  receipts             Receipt[]         @relation("ReceiptTenant")
  refundRequests       RefundRequest[]   @relation("RefundTenant")
  tenantCredits        TenantCredit[]    @relation("CreditTenant")

  // Relations — Maintenance (Module 4.1)
  maintenanceTickets   MaintenanceTicket[] @relation("TicketReportedByTenant")
  securityIncidents    SecurityIncident[]

  // Relations — Banking (Module 3.6)
  paymentGatewayTxns   PaymentGatewayTransaction[] @relation("GatewayTenant")

  // Relations — Portal (Module 5.1)
  residents            Resident[]         @relation("ResidentTenant")

  // Relations — Mall (Module 6.1)
  gtoSubmissions       GtoSubmission[]
  camBillings          CamBilling[]       @relation("CamBillingTenant")
  camReconciliations   CamReconciliation[] @relation("CamReconTenant")
  boothRentals         BoothRental[]      @relation("BoothTenant")

  @@index([companyId])
  @@index([email])
  @@index([kycStatus])
  @@index([isBlacklisted])
  @@map("tenants")
}

model KycRequirement {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  tenantType   String  @map("tenant_type") @db.VarChar(20) // 'individual' | 'company'
  docType      String  @map("doc_type") @db.VarChar(100)
  name         String  @db.VarChar(255)
  description  String? @db.Text
  isRequired   Boolean @default(true) @map("is_required")
  validityDays Int?    @map("validity_days") @db.SmallInt
  sortOrder    Int     @default(0) @map("sort_order") @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kycDocuments TenantKycDocument[]

  @@index([companyId, tenantType])
  @@map("kyc_requirements")
}

model TenantKycDocument {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  requirementId   String    @map("requirement_id") @db.Uuid
  documentId      String?   @map("document_id") @db.Uuid
  docType         String    @map("doc_type") @db.VarChar(100)
  submittedAt     DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  status          String    @default("pending") @db.VarChar(20) // 'pending'|'approved'|'rejected'
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.Text
  expiryDate      DateTime? @map("expiry_date") @db.Date

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirement     KycRequirement @relation(fields: [requirementId], references: [id])
  reviewer        User?    @relation("KycReviewer", fields: [reviewedBy], references: [id])

  @@unique([tenantId, requirementId], name: "uq_tenant_kyc_req")
  @@index([tenantId])
  @@map("tenant_kyc_documents")
}

model TenantEmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(200)
  relationship String   @db.VarChar(50)
  phone        String   @db.VarChar(50)
  mobile       String?  @db.VarChar(50)
  email        String?  @db.VarChar(255)
  isPrimary    Boolean  @default(false) @map("is_primary")
  sortOrder    Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_emergency_contacts")
}

model TenantBlacklistLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  action      String   @db.VarChar(10)  // 'blacklist' | 'whitelist'
  reason      String   @db.Text
  scope       String   @default("company") @db.VarChar(20) // 'company' | 'property'
  propertyId  String?  @map("property_id") @db.Uuid
  actionedBy  String   @map("actioned_by") @db.Uuid
  actionedAt  DateTime @default(now()) @map("actioned_at") @db.Timestamptz
  notes       String?  @db.Text

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actionedByUser User  @relation("BlacklistActioner", fields: [actionedBy], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@map("tenant_blacklist_log")
}

model TenantNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  content    String   @db.Text
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author     User     @relation("TenantNoteAuthor", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@map("tenant_notes")
}

// ─────────────────────────────────────────────
// MODULE 2.4 — LEASE MANAGEMENT (Phase 2)
// ─────────────────────────────────────────────

model LeaseTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String   @db.VarChar(255)
  propertyType  String?  @map("property_type") @db.VarChar(50)
  description   String?  @db.Text
  defaultTerms  Json     @default("{}") @map("default_terms")
  clauses       Json     @default("[]")
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     String?  @map("created_by") @db.Uuid

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator       User?    @relation("LeaseTemplateCreator", fields: [createdBy], references: [id])
  leases        Lease[]

  @@index([companyId])
  @@map("lease_templates")
}

model Lease {
  id                      String    @id @default(uuid()) @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  propertyId              String    @map("property_id") @db.Uuid
  unitId                  String    @map("unit_id") @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  templateId              String?   @map("template_id") @db.Uuid
  leaseNumber             String    @map("lease_number") @db.VarChar(50)
  status                  String    @default("draft") @db.VarChar(30)
  // 'draft'|'pending_approval'|'approved'|'active'|'expired'|'terminated'|'renewed'|'cancelled'

  startDate               DateTime  @map("start_date") @db.Date
  endDate                 DateTime  @map("end_date") @db.Date
  handoverDate            DateTime? @map("handover_date") @db.Date
  leaseTermMonths         Int       @map("lease_term_months") @db.SmallInt

  rentAmount              Decimal   @map("rent_amount") @db.Decimal(15, 2)
  currency                String    @default("USD") @db.VarChar(3)
  billingCycle            String    @default("monthly") @map("billing_cycle") @db.VarChar(20)
  billingDay              Int       @default(1) @map("billing_day") @db.SmallInt
  paymentDueDays          Int       @default(7) @map("payment_due_days") @db.SmallInt

  securityDeposit         Decimal   @default(0) @map("security_deposit") @db.Decimal(15, 2)
  depositPaid             Boolean   @default(false) @map("deposit_paid")
  depositPaidAt           DateTime? @map("deposit_paid_at") @db.Timestamptz
  depositRefunded         Boolean   @default(false) @map("deposit_refunded")
  depositRefundedAt       DateTime? @map("deposit_refunded_at") @db.Timestamptz

  // Escalation
  escalationType          String?   @map("escalation_type") @db.VarChar(20)
  escalationValue         Decimal?  @map("escalation_value") @db.Decimal(8, 4)
  escalationFrequency     String?   @default("annual") @map("escalation_frequency") @db.VarChar(20)
  escalationDay           Int?      @map("escalation_day") @db.SmallInt
  escalationMonth         Int?      @map("escalation_month") @db.SmallInt

  // Renewal
  isRenewed               Boolean   @default(false) @map("is_renewed")
  parentLeaseId           String?   @map("parent_lease_id") @db.Uuid
  renewalOfferedAt        DateTime? @map("renewal_offered_at") @db.Timestamptz
  renewalOfferExpiresAt   DateTime? @map("renewal_offer_expires_at") @db.Timestamptz
  renewalAcceptedAt       DateTime? @map("renewal_accepted_at") @db.Timestamptz

  // Termination
  terminationDate         DateTime? @map("termination_date") @db.Date
  terminationReason       String?   @map("termination_reason") @db.Text
  terminationType         String?   @map("termination_type") @db.VarChar(20)
  earlyTerminationPenalty Decimal?  @map("early_termination_penalty") @db.Decimal(15, 2)

  // E-signature
  esignStatus             String    @default("not_started") @map("esign_status") @db.VarChar(20)
  esignEnvelopeId         String?   @map("esign_envelope_id") @db.VarChar(255)
  esignCompletedAt        DateTime? @map("esign_completed_at") @db.Timestamptz
  leaseDocumentUrl        String?   @map("lease_document_url") @db.Text

  // Workflow
  workflowInstanceId      String?   @map("workflow_instance_id") @db.Uuid

  // Content
  notes                   String?   @db.Text
  specialConditions       String?   @map("special_conditions") @db.Text
  clauses                 Json      @default("[]")

  // Audit
  createdBy               String    @map("created_by") @db.Uuid
  approvedBy              String?   @map("approved_by") @db.Uuid
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz
  activatedAt             DateTime? @map("activated_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz

  company                 Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property                Property        @relation(fields: [propertyId], references: [id])
  unit                    Unit            @relation(fields: [unitId], references: [id])
  tenant                  Tenant          @relation(fields: [tenantId], references: [id])
  template                LeaseTemplate?  @relation(fields: [templateId], references: [id])
  creator                 User            @relation("LeaseCreator", fields: [createdBy], references: [id])
  approver                User?           @relation("LeaseApprover", fields: [approvedBy], references: [id])
  parentLease             Lease?          @relation("LeaseRenewal", fields: [parentLeaseId], references: [id])
  renewalLeases           Lease[]         @relation("LeaseRenewal")

  amendments              LeaseAmendment[]
  escalationSchedule      LeaseEscalationSchedule[]
  esignRecipients         EsignRecipient[]

  // Relations — CRM (Module 2.5)
  convertedLeads          Lead[]          @relation("ConvertedLease")

  // Relations — Parking (Module 2.6)
  parkingAllocations      ParkingAllocation[] @relation("AllocationLease")

  // Relations — Billing (Module 3.1)
  billingSchedules        BillingSchedule[] @relation("ScheduleLease")
  invoices                Invoice[]         @relation("InvoiceLease")

  // Relations — Portal (Module 5.1)
  residents               Resident[]        @relation("ResidentLease")

  // Relations — Community (Module 5.4)
  moveRequests            MoveRequest[]     @relation("MoveRequestLease")

  // Relations — Mall (Module 6.1)
  commercialLease         CommercialLease?
  gtoSubmissions          GtoSubmission[]
  camBillings             CamBilling[]      @relation("CamBillingLease")

  @@index([companyId])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([status])
  @@index([endDate])
  @@map("leases")
}

model LeaseAmendment {
