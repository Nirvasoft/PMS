// ─────────────────────────────────────────────
// MODULE 1.4 — WORKFLOW ENGINE
// ─────────────────────────────────────────────

model WorkflowDefinition {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String    @db.VarChar(255)
  description   String?   @db.Text
  entityType    String    @map("entity_type") @db.VarChar(100)
  version       Int       @default(1) @db.SmallInt
  status        String    @default("draft") @db.VarChar(20)
  graph         Json
  settings      Json      @default("{}")
  createdBy     String?   @map("created_by") @db.Uuid
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator       User?     @relation("WfDefinitionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  instances     WorkflowInstance[]

  @@index([companyId, entityType])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id                String    @id @default(uuid()) @db.Uuid
  definitionId      String    @map("definition_id") @db.Uuid
  definitionVersion Int       @map("definition_version") @db.SmallInt
  entityType        String    @map("entity_type") @db.VarChar(100)
  entityId          String    @map("entity_id") @db.VarChar(255)
  companyId         String    @map("company_id") @db.Uuid
  currentNodeIds    String[]  @map("current_node_ids")
  status            String    @default("running") @db.VarChar(20)
  initiatedBy       String    @map("initiated_by") @db.Uuid
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz
  cancelReason      String?   @map("cancel_reason") @db.Text
  context           Json      @default("{}")
  metadata          Json      @default("{}")
  delayedUntil      DateTime? @map("delayed_until") @db.Timestamptz
  delayNodeId       String?   @map("delay_node_id") @db.VarChar(100)

  definition        WorkflowDefinition @relation(fields: [definitionId], references: [id])
  company           Company            @relation(fields: [companyId], references: [id])
  initiator         User               @relation("WfInstanceInitiator", fields: [initiatedBy], references: [id])
  tasks             WorkflowTask[]
  history           WorkflowHistory[]
  slaJobs           WorkflowSlaJob[]

  @@index([entityType, entityId])
  @@index([status])
  @@map("workflow_instances")
}

model WorkflowTask {
  id            String    @id @default(uuid()) @db.Uuid
  instanceId    String    @map("instance_id") @db.Uuid
  nodeId        String    @map("node_id") @db.VarChar(100)
  taskType      String    @default("approval") @map("task_type") @db.VarChar(30)
  title         String    @db.VarChar(255)
  assignedTo    String?   @map("assigned_to") @db.Uuid
  assignedRole  String?   @map("assigned_role") @db.VarChar(100)
  delegatedTo   String?   @map("delegated_to") @db.Uuid
  delegatedAt   DateTime? @map("delegated_at") @db.Timestamptz
  status        String    @default("pending") @db.VarChar(20)
  decision      String?   @db.VarChar(20)
  comments      String?   @db.Text
  slaDueAt      DateTime? @map("sla_due_at") @db.Timestamptz
  slaBreached   Boolean   @default(false) @map("sla_breached")
  remindedAt    DateTime? @map("reminded_at") @db.Timestamptz
  escalatedAt   DateTime? @map("escalated_at") @db.Timestamptz
  escalatedTo   String?   @map("escalated_to") @db.Uuid
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  completedBy   String?   @map("completed_by") @db.Uuid
  attachments   Json      @default("[]")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  instance      WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee      User?            @relation("WfTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  delegatee     User?            @relation("WfTaskDelegatee", fields: [delegatedTo], references: [id], onDelete: SetNull)
  completer     User?            @relation("WfTaskCompleter", fields: [completedBy], references: [id], onDelete: SetNull)
  escalator     User?            @relation("WfTaskEscalator", fields: [escalatedTo], references: [id], onDelete: SetNull)
  historyItems  WorkflowHistory[]
  slaJobs       WorkflowSlaJob[]

  @@index([assignedTo, status])
  @@index([instanceId])
  @@index([slaDueAt], map: "idx_wf_tasks_sla")
  @@map("workflow_tasks")
}

model WorkflowHistory {
  id           String    @id @default(uuid()) @db.Uuid
  instanceId   String    @map("instance_id") @db.Uuid
  taskId       String?   @map("task_id") @db.Uuid
  fromNodeId   String?   @map("from_node_id") @db.VarChar(100)
  toNodeId     String?   @map("to_node_id") @db.VarChar(100)
  action       String    @db.VarChar(50)
  performedBy  String?   @map("performed_by") @db.Uuid
  comments     String?   @db.Text
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  task         WorkflowTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  performer    User?            @relation("WfHistoryPerformer", fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([instanceId, createdAt])
  @@map("workflow_history")
}

model WorkflowSlaJob {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  instanceId   String    @map("instance_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  type         String    @db.VarChar(30)   // 'reminder' | 'breach' | 'escalation'
  scheduledAt  DateTime  @map("scheduled_at") @db.Timestamptz
  executedAt   DateTime? @map("executed_at") @db.Timestamptz
  status       String    @default("pending") @db.VarChar(20) // 'pending' | 'executed' | 'cancelled'
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  task         WorkflowTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([taskId])
  @@map("workflow_sla_jobs")
}

