  propertyId   String    @map("property_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String    @db.VarChar(100)
  code         String?   @db.VarChar(20)
  zoneType     String    @default("covered") @map("zone_type") @db.VarChar(20)
