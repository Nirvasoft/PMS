model WorkOrder {
  id              String    @id @default(uuid()) @db.Uuid
  ticketId        String    @map("ticket_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  woNumber        String    @unique @map("wo_number") @db.VarChar(30)
  title           String    @db.VarChar(500)
  description     String?   @db.Text
  assignedToId    String    @map("assigned_to") @db.Uuid
  status          String    @default("pending") @db.VarChar(20)
                            // 'pending'|'accepted'|'in_progress'|'on_hold'|'completed'|'cancelled'
  scheduledStart  DateTime? @map("scheduled_start") @db.Timestamptz
  scheduledEnd    DateTime? @map("scheduled_end") @db.Timestamptz
  actualStart     DateTime? @map("actual_start") @db.Timestamptz
  actualEnd       DateTime? @map("actual_end") @db.Timestamptz
  estimatedHours  Decimal?  @map("estimated_hours") @db.Decimal(5, 2)
  actualHours     Decimal?  @map("actual_hours") @db.Decimal(5, 2)
  // Labor cost
  laborRate       Decimal?  @map("labor_rate") @db.Decimal(10, 2)
  laborCost       Decimal?  @map("labor_cost") @db.Decimal(12, 2)
  // Materials cost
  materialsCost   Decimal   @default(0) @map("materials_cost") @db.Decimal(12, 2)
  totalCost       Decimal   @default(0) @map("total_cost") @db.Decimal(12, 2)
  // Completion
  completionNotes String?   @map("completion_notes") @db.Text
  checklist       Json?     @default("[]") @db.JsonB
  onHoldReason    String?   @map("on_hold_reason") @db.Text
  cancelledReason String?   @map("cancelled_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  ticket          MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id])
