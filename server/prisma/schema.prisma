                            // 'manual'|'ar_receipt'|'ar_invoice'|'ap_payment'|'ap_invoice'|'depreciation'|'adjustment'
  description     String    @db.VarChar(500)
  status          String    @default("draft") @db.VarChar(20)
                            // 'draft' | 'posted' | 'reversed'
  referenceType   String?   @map("reference_type") @db.VarChar(50)
  referenceId     String?   @map("reference_id") @db.Uuid
  isReversal      Boolean   @default(false) @map("is_reversal")
  reversalOfId    String?   @map("reversal_of_id") @db.Uuid
  reversedById    String?   @map("reversed_by_id") @db.Uuid
  totalDebit      Decimal   @default(0) @map("total_debit") @db.Decimal(15, 2)
  totalCredit     Decimal   @default(0) @map("total_credit") @db.Decimal(15, 2)
  postedBy        String?   @map("posted_by") @db.Uuid
  postedAt        DateTime? @map("posted_at") @db.Timestamptz
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalPeriod   FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  lines          JournalEntryLine[]

  @@index([companyId, entryDate(sort: Desc)])
  @@index([fiscalPeriodId])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String   @id @default(uuid()) @db.Uuid
  journalEntryId  String   @map("journal_entry_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  description     String?  @db.VarChar(500)
  debit           Decimal  @default(0) @db.Decimal(15, 2)
  credit          Decimal  @default(0) @db.Decimal(15, 2)
  propertyId      String?  @map("property_id") @db.Uuid
  departmentId    String?  @map("department_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order") @db.SmallInt

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        GlAccount    @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

