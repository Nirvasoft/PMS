  toDate           DateTime  @db.Date
  totalCredits     Decimal?  @db.Decimal(15, 2)
  totalDebits      Decimal?  @db.Decimal(15, 2)
  transactionCount Int?      @db.SmallInt
  status           String    @default("pending") @db.VarChar(20)
  importedBy       String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz()

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id])
  company     Company             @relation(fields: [companyId], references: [id])
  lines       BankStatementLine[]

  @@index([bankAccountId])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id                 String    @id @default(uuid()) @db.Uuid
  importId           String    @db.Uuid
  bankAccountId      String    @db.Uuid
  transactionDate    DateTime  @db.Date
  valueDate          DateTime? @db.Date
  description        String?   @db.VarChar(500)
  reference          String?   @db.VarChar(255)
  creditAmount       Decimal   @default(0) @db.Decimal(15, 2)
  debitAmount        Decimal   @default(0) @db.Decimal(15, 2)
  balance            Decimal?  @db.Decimal(15, 2)
  matchStatus        String    @default("unmatched") @db.VarChar(20)
  matchedEntityType  String?   @db.VarChar(30)
