model NotificationTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  code        String    @db.VarChar(100)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  channels    String[]  @default([])
  subject     String?   @db.VarChar(500)
  bodyText    String    @map("body_text") @db.Text
  bodyHtml    String?   @map("body_html") @db.Text
  bodyPush    String?   @map("body_push") @db.VarChar(500)
  variables   Json      @default("[]")
  isCritical  Boolean   @default(false) @map("is_critical")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs        NotificationLog[]

  @@unique([code, companyId], name: "uq_template_code_company")
  @@map("notification_templates")
}

model NotificationLog {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String?   @map("company_id") @db.Uuid
  templateId         String?   @map("template_id") @db.Uuid
  templateCode       String?   @map("template_code") @db.VarChar(100)
  channel            String    @db.VarChar(20)
  recipientId        String?   @map("recipient_id") @db.Uuid
  recipientEmail     String?   @map("recipient_email") @db.VarChar(255)
  recipientPhone     String?   @map("recipient_phone") @db.VarChar(50)
  subject            String?   @db.VarChar(500)
  body               String?   @db.Text
  status             String    @default("queued") @db.VarChar(20)
  provider           String?   @db.VarChar(50)
  providerMessageId  String?   @map("provider_message_id") @db.VarChar(255)
  errorMessage       String?   @map("error_message") @db.Text
  retryCount         Int       @default(0) @map("retry_count") @db.SmallInt
  sentAt             DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz
  entityType         String?   @map("entity_type") @db.VarChar(100)
  entityId           String?   @map("entity_id") @db.Uuid
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  template           NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipient          User?     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([entityType, entityId])
  @@map("notification_logs")
}

model InAppNotification {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(255)
  body        String    @db.Text
  icon        String    @default("bell") @db.VarChar(50)
  actionType  String?   @map("action_type") @db.VarChar(50)
  actionUrl   String?   @map("action_url") @db.VarChar(500)
  entityType  String?   @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.Uuid
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User      @relation("InAppNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("in_app_notifications")
}

model NotificationPreference {
  userId          String    @map("user_id") @db.Uuid
  templateCode    String    @map("template_code") @db.VarChar(100)
  emailEnabled    Boolean   @default(true) @map("email_enabled")
  smsEnabled      Boolean   @default(false) @map("sms_enabled")
  pushEnabled     Boolean   @default(true) @map("push_enabled")
  inAppEnabled    Boolean   @default(true) @map("in_app_enabled")
  quietHoursStart String?   @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd   String?   @map("quiet_hours_end") @db.VarChar(5)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user            User      @relation("NotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, templateCode])
  @@map("notification_preferences")
}

/// Scheduled notifications for future delivery (rent reminders, lease expiry alerts).
/// Supports one-shot and recurring (via recurrenceCron).
model ScheduledNotification {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  templateCode    String    @map("template_code") @db.VarChar(100)
  recipientIds    Json      @map("recipient_ids")          // string[] of user IDs
  variables       Json?     @default("{}")                  // template variables
  channels        String[]  @default([])                    // override channels
  scheduledAt     DateTime  @map("scheduled_at") @db.Timestamptz
  recurrenceCron  String?   @map("recurrence_cron") @db.VarChar(50)  // e.g. "0 9 1 * *" for monthly
  status          String    @default("pending") @db.VarChar(20)      // pending | sent | cancelled | failed
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  errorMessage    String?   @map("error_message")
  entityType      String?   @map("entity_type") @db.VarChar(50)
  entityId        String?   @map("entity_id") @db.Uuid
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company         Company   @relation("ScheduledNotifications", fields: [companyId], references: [id], onDelete: Cascade)
  creator         User?     @relation("ScheduledNotificationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([companyId])
  @@map("scheduled_notifications")
}

/// Push device tokens for mobile app push notifications.
/// One user can have multiple devices.
model PushDeviceToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  token       String    @db.VarChar(500)           // FCM / APNs token
  platform    String    @db.VarChar(20)            // ios | android | web
  deviceName  String?   @map("device_name") @db.VarChar(100)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user        User      @relation("PushDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("push_device_tokens")
}

/// DB-backed notification dispatch queue. Notifications are enqueued here
/// and processed by a cron job every 10 seconds, with retry + backoff.
model NotificationQueueItem {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  templateCode  String    @map("template_code") @db.VarChar(100)
  recipientIds  Json      @map("recipient_ids")          // string[]
  variables     Json?     @default("{}")
  channels      String[]  @default([])
  status        String    @default("pending") @db.VarChar(20) // pending | processing | sent | failed
  priority      Int       @default(0)                     // higher = processed first
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3) @map("max_attempts")
  nextRetryAt   DateTime? @map("next_retry_at") @db.Timestamptz
  errorMessage  String?   @map("error_message")
  entityType    String?   @map("entity_type") @db.VarChar(50)
  entityId      String?   @map("entity_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz

  company       Company   @relation("NotificationQueue", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([status, nextRetryAt])
  @@map("notification_queue")
}

// ─────────────────────────────────────────────
// SSO — SINGLE SIGN-ON (FUTURE-READY)
// ─────────────────────────────────────────────

/// Stores SSO/IdP configuration per company.
/// Supports OIDC (Azure AD, Okta, Google Workspace) and SAML.
model SsoConfig {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  name              String    @db.VarChar(255)        // "Acme Azure AD"
  provider          String    @db.VarChar(50)         // oidc | saml | azure_ad | okta | google
  protocol          String    @default("oidc") @db.VarChar(10) // oidc | saml
  isEnabled         Boolean   @default(false) @map("is_enabled")
  isDefault         Boolean   @default(false) @map("is_default")

  // OIDC fields
  clientId          String?   @map("client_id") @db.VarChar(255)
  clientSecret      String?   @map("client_secret") @db.VarChar(500) // encrypted at rest
  issuerUrl         String?   @map("issuer_url") @db.VarChar(500)    // e.g. https://login.microsoftonline.com/{tenant}/v2.0
  authorizationUrl  String?   @map("authorization_url") @db.VarChar(500)
  tokenUrl          String?   @map("token_url") @db.VarChar(500)
  userInfoUrl       String?   @map("userinfo_url") @db.VarChar(500)
  scopes            String    @default("openid profile email") @db.VarChar(500)

  // SAML fields (future)
  entityId          String?   @map("entity_id") @db.VarChar(500)
  ssoUrl            String?   @map("sso_url") @db.VarChar(500)
  certificate       String?   @db.Text

  // Mapping & provisioning
  autoProvision     Boolean   @default(false) @map("auto_provision")  // JIT user creation
  defaultRoleId     String?   @map("default_role_id") @db.Uuid       // Role for JIT-provisioned users
  domainRestriction String?   @map("domain_restriction") @db.VarChar(255) // e.g. "acme.com"
  attributeMapping  Json      @default("{}") @map("attribute_mapping") // Map IdP claims → PMS fields
  settings          Json      @default("{}")                          // Extra provider-specific config

  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  identities        SsoIdentity[]

  @@unique([companyId, provider], name: "uq_sso_company_provider")
  @@map("sso_configs")
}

/// Links an external IdP identity to a PMS user.
/// One user can have multiple SSO identities (e.g. Azure AD + Google).
model SsoIdentity {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  ssoConfigId       String    @map("sso_config_id") @db.Uuid
  externalId        String    @map("external_id") @db.VarChar(255) // sub / nameId from IdP
  externalEmail     String?   @map("external_email") @db.VarChar(255)
  externalUsername  String?   @map("external_username") @db.VarChar(255)
  rawAttributes     Json      @default("{}") @map("raw_attributes") // Full IdP profile snapshot
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user              User      @relation("UserSsoIdentities", fields: [userId], references: [id], onDelete: Cascade)
  ssoConfig         SsoConfig @relation(fields: [ssoConfigId], references: [id], onDelete: Cascade)

  @@unique([ssoConfigId, externalId], name: "uq_sso_identity")
  @@index([userId])
  @@map("sso_identities")
}

