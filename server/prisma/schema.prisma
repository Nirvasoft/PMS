model Property {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  businessUnitId   String?   @map("business_unit_id") @db.Uuid
  propertyTypeId   String?   @map("property_type_id") @db.Uuid
  name             String    @db.VarChar(255)
  code             String?   @db.VarChar(50)
  propertyType     String    @default("residential") @map("property_type") @db.VarChar(50)
  legalName        String?   @map("legal_name") @db.VarChar(255)
  registrationNo   String?   @map("registration_no") @db.VarChar(100)
  status           String    @default("active") @db.VarChar(30)
  addressLine1     String?   @map("address_line1") @db.VarChar(255)
  addressLine2     String?   @map("address_line2") @db.VarChar(255)
  city             String?   @db.VarChar(100)
  state            String?   @db.VarChar(100)
  postalCode       String?   @map("postal_code") @db.VarChar(20)
  country          String?   @db.VarChar(2)
  geoLat           Decimal?  @map("geo_lat") @db.Decimal(9, 6)
  geoLng           Decimal?  @map("geo_lng") @db.Decimal(9, 6)
  geoFence         Json?     @map("geo_fence")             // polygon coords array (Phase 2 stub)
  yearBuilt        Int?      @map("year_built") @db.SmallInt
  totalFloors      Int?      @map("total_floors") @db.SmallInt
  totalUnits       Int       @default(0) @map("total_units") @db.SmallInt
  totalAreaSqm     Decimal?  @map("total_area_sqm") @db.Decimal(12, 2)
  totalAreaSqft    Decimal?  @map("total_area_sqft") @db.Decimal(12, 2)
  coverImageUrl    String?   @map("cover_image_url") @db.VarChar(500)
  imageUrl         String?   @map("image_url") @db.VarChar(500)  // legacy — use coverImageUrl
  managerId        String?   @map("manager_id") @db.Uuid
  billingCycle     String    @default("monthly") @map("billing_cycle") @db.VarChar(20)
  billingDay       Int       @default(1) @map("billing_day") @db.SmallInt
  currency         String    @default("USD") @db.VarChar(3)
  timezone         String    @default("UTC") @db.VarChar(60)
  description      String?   @db.Text
  settings         Json      @default("{}")                // property-level overrides
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  businessUnit     BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  propertyTypeRef  PropertyType?  @relation(fields: [propertyTypeId], references: [id], onDelete: SetNull)
  manager          User?          @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull)
  regionProperties RegionProperty[]
  photos           PropertyPhoto[]
  facilities       PropertyFacility[]
  contacts         PropertyContact[]
  statusHistory    PropertyStatusHistory[]

  // Relations — Units (Module 2.2)
  towers           Tower[]
  units            Unit[]
  utilityMeters    UtilityMeter[]
  floorSetups      FloorSetup[]

  // Relations — Tenants (Module 2.3)
  blacklistScoped  TenantBlacklistLog[]

  // Relations — Leases (Module 2.4)
  leases           Lease[]

  // Relations — CRM (Module 2.5)
  leads            Lead[]
  leadViewings     LeadViewing[]  @relation("ViewingProperty")
  marketingCampaigns MarketingCampaign[]

  // Relations — Parking (Module 2.6)
  parkingZones     ParkingZone[]
  parkingSlots     ParkingSlot[]
  parkingAllocations ParkingAllocation[]
  visitorParkingPasses VisitorParkingPass[]
  rfidAccessEvents   RfidAccessEvent[]

  // Relations — Billing (Module 3.1)
  meterSetups      MeterSetup[]
  billingSchedules BillingSchedule[] @relation("ScheduleProperty")
  invoices         Invoice[]         @relation("InvoiceProperty")
  penaltyConfigs   PenaltyConfiguration[] @relation("PenaltyProperty")

  // Relations — AR (Module 3.2)
  receipts         Receipt[]         @relation("ReceiptProperty")

  // Relations — AP (Module 3.3)
  apInvoices       ApInvoice[]
  expenses         Expense[]

  // Relations — Banking (Module 3.6)
  paymentGatewayTxns PaymentGatewayTransaction[]

  // Relations — Maintenance (Module 4.1)
  maintenanceTickets MaintenanceTicket[]
  pmSchedules        PmSchedule[]
  facilityAssets     FacilityAsset[]
  camCostEntries     CamCostEntry[]
  utilitySystems     UtilitySystem[]
  stores             Store[]
  purchaseRequisitions PurchaseRequisition[]
  housekeepingZones  HousekeepingZone[]
  cleaningSchedules  CleaningSchedule[]
  cleaningTasks      CleaningTask[]
  housekeepingInspections HousekeepingInspection[]
  securityIncidents  SecurityIncident[]
  patrolCheckpoints  PatrolCheckpoint[]
  patrolSchedules    PatrolSchedule[]
  patrolLogs         PatrolLog[]
  accessControlEvents AccessControlEvent[]

  // Relations — Portal (Module 5.1)
  residents          Resident[]
  residentAccessCards ResidentAccessCard[]
  portalQuickActions  PortalQuickAction[]

  // Relations — Visitors/Booking/Community (Module 5.2-5.4)
  visitors             Visitor[]
  facilityBookingRules FacilityBookingRule[]
  facilityBookings     FacilityBooking[]
  bookingBlackoutDates BookingBlackoutDate[]
  announcements        Announcement[]
  polls                Poll[]
  communityComplaints  CommunityComplaint[]
  moveRequests         MoveRequest[]

  // Relations — Mall (Module 6.1)
  mallProperty         MallProperty?
  shopProfiles         ShopProfile[]
  gtoSubmissions       GtoSubmission[]
  camCostPools         CamCostPool[]
  camBillings          CamBilling[]
  camReconciliations   CamReconciliation[]
  mallEvents           MallEvent[]
  boothRentals         BoothRental[]
  footfallSensors      FootfallSensor[]
  footfallCounts       FootfallCount[]

  // Relations — Condo (Module 6.2)
  smartMeterReadings   SmartMeterReading[] @relation("ReadingProperty")
  smartMeterDevices    SmartMeterDevice[]  @relation("DeviceProperty")
  fundAccounts         FundAccount[]
  generalMeetings      GeneralMeeting[]
  bylaws               Bylaw[]
  bylawViolations      BylawViolation[]   @relation("ViolationProperty")

  // Relations — BI (Module 6.3)
  biForecasts          BiForecast[]
  biAnomalies          BiAnomaly[]
  bmsDevices           BmsDevice[]

  @@unique([code, companyId], name: "uq_property_code_company")
  @@index([companyId])
  @@index([status])
  @@map("properties")
}

model RegionProperty {
