// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ORGANIZATION (minimal for auth FK)
// ─────────────────────────────────────────────

model Company {
  id              String    @id @default(uuid()) @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  code            String    @unique @db.VarChar(20)
  name            String    @db.VarChar(255)
  legalName       String?   @map("legal_name") @db.VarChar(255)
  companyType     String    @default("standalone") @map("company_type") @db.VarChar(30)
  registrationNo  String?   @map("registration_no") @db.VarChar(100)
  taxId           String?   @map("tax_id") @db.VarChar(100)
  industry        String?   @db.VarChar(100)
  phone           String?   @db.VarChar(50)
  email           String?   @db.VarChar(255)
  website         String?   @db.VarChar(255)
  addressLine1    String?   @map("address_line1") @db.VarChar(255)
  addressLine2    String?   @map("address_line2") @db.VarChar(255)
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  postalCode      String?   @map("postal_code") @db.VarChar(20)
  country         String    @default("US") @db.VarChar(2)
  timezone        String?   @default("UTC") @db.VarChar(60)
  currency        String?   @default("USD") @db.VarChar(3)
  logoUrl         String?   @map("logo_url") @db.VarChar(500)
  isActive        Boolean   @default(true) @map("is_active")
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  parent          Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries    Company[] @relation("CompanyHierarchy")
  users           User[]
  passwordPolicies PasswordPolicy[]
  ipPolicies      IpPolicy[]
  authAuditLogs   AuthAuditLog[]
  departments     Department[]
  positions       Position[]
  roles           Role[]
  userInvitations UserInvitation[]

  // Relations — Organization (Module 1.3)
  branches        Branch[]
  regions         Region[]
  businessUnits   BusinessUnit[]
  properties      Property[]
  floorSetups     FloorSetup[]

  // Relations — Workflow (Module 1.4)
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  workflowSlaJobs     WorkflowSlaJob[]

  // Relations — Notifications (Module 1.5)
  notificationTemplates  NotificationTemplate[]
  notificationLogs       NotificationLog[]
  inAppNotifications     InAppNotification[]
  scheduledNotifications ScheduledNotification[] @relation("ScheduledNotifications")
  notificationQueue      NotificationQueueItem[] @relation("NotificationQueue")

  // Relations — SSO
  ssoConfigs          SsoConfig[]

  // Relations — Documents (Module 1.6)
  documentFolders     DocumentFolder[]
  documents           Document[]

  // Relations — Dashboard (Module 1.7)
  savedReports        SavedReport[]

  // Relations — Units (Module 2.2)
  towers              Tower[]
  units               Unit[]
  utilityMeters       UtilityMeter[]

  // Relations — Tenants (Module 2.3)
  tenants             Tenant[]
  kycRequirements     KycRequirement[]
  blacklistLogs       TenantBlacklistLog[]

  // Relations — Leases (Module 2.4)
  leases              Lease[]
  leaseTemplates      LeaseTemplate[]
  leaseClauses        LeaseClause[]

  // Relations — CRM (Module 2.5)
  leads               Lead[]
  marketingCampaigns  MarketingCampaign[]

  // Relations — Parking (Module 2.6)
  parkingZones        ParkingZone[]
  parkingSlots        ParkingSlot[]
  parkingAllocations  ParkingAllocation[]
  tenantVehicles      TenantVehicle[]

  // Relations — Billing (Module 3.1)
  chargeTypes           ChargeType[]
  meterSetups           MeterSetup[]
  billingSchedules      BillingSchedule[]
  invoices              Invoice[]
  penaltyConfigurations PenaltyConfiguration[]
  taxConfigurations     TaxConfiguration[]

  // Relations — AR (Module 3.2)
  receipts              Receipt[]
  refundRequests        RefundRequest[]
  tenantCredits         TenantCredit[]

  // Relations — GL (Module 3.4)
  glAccounts            GlAccount[]
  fiscalPeriods         FiscalPeriod[]
  journalEntries        JournalEntry[]

  // Relations — Budgets & Assets (Module 3.5)
  budgets               Budget[]
  fixedAssets            FixedAsset[]

  // Relations — Banking (Module 3.6)
  bankAccounts          BankAccount[]
  bankStatementImports  BankStatementImport[]
  paymentGatewayTxns    PaymentGatewayTransaction[]

  // Relations — Maintenance (Module 4.1)
  maintenanceCategories    MaintenanceCategory[]
  maintenanceSlaConfigs    MaintenanceSlaConfig[]
  maintenanceTickets       MaintenanceTicket[]
  ticketPhotos             TicketPhoto[]
  workOrders               WorkOrder[]
  workOrderMaterials       WorkOrderMaterial[]
  technicianProfiles       TechnicianProfile[]
  slaBreachEvents          SlaBreachEvent[]
  pmSchedules              PmSchedule[]
  pmWorkOrders             PmWorkOrder[]
  facilityAssets           FacilityAsset[]
  camCostEntries           CamCostEntry[]
  utilitySystems           UtilitySystem[]
  stores                   Store[]
  inventoryItems           InventoryItem[]
  stockLevels              StockLevel[]
  stockMovements           StockMovement[]
  purchaseRequisitions     PurchaseRequisition[]
  housekeepingZones        HousekeepingZone[]
  cleaningSchedules        CleaningSchedule[]
  cleaningTasks            CleaningTask[]
  housekeepingInspections  HousekeepingInspection[]
  securityIncidents        SecurityIncident[]
  patrolCheckpoints        PatrolCheckpoint[]
  patrolSchedules          PatrolSchedule[]
  patrolLogs               PatrolLog[]
  accessControlEvents      AccessControlEvent[]

  // Relations — Portal (Module 5.1)
  residents                Resident[]
  residentAccessCards      ResidentAccessCard[]
  portalSessions           PortalSession[]
  portalQuickActions       PortalQuickAction[]

  // Relations — Visitors/Booking/Community (Module 5.2-5.4)
  visitors                 Visitor[]
  walkinApprovals          WalkinApproval[]
  visitorBlacklist         VisitorBlacklist[]
  facilityBookingRules     FacilityBookingRule[]
  facilityBookings         FacilityBooking[]
  bookingBlackoutDates     BookingBlackoutDate[]
  announcements            Announcement[]
  announcementReads        AnnouncementRead[]
  polls                    Poll[]
  pollVotes                PollVote[]
  communityComplaints      CommunityComplaint[]
  moveRequests             MoveRequest[]

  // Relations — Mall (Module 6.1)
  mallProperties           MallProperty[]
  shopProfiles             ShopProfile[]
  commercialLeases         CommercialLease[]
  gtoSubmissions           GtoSubmission[]
  camCostPools             CamCostPool[]
  camBillings              CamBilling[]
  camReconciliations       CamReconciliation[]
  mallEvents               MallEvent[]
  boothRentals             BoothRental[]
  footfallSensors          FootfallSensor[]
  footfallCounts           FootfallCount[]
  biForecasts              BiForecast[]
  biAnomalies              BiAnomaly[]

  // Relations — Condo (Module 6.2)
  smartMeterReadings       SmartMeterReading[]
  smartMeterDevices        SmartMeterDevice[]
  fundAccounts             FundAccount[]
  fundTransactions         FundTransaction[]
  generalMeetings          GeneralMeeting[]
  meetingResolutions       MeetingResolution[]
  meetingProxies           MeetingProxy[]
  meetingVotes             MeetingVote[]
  bylaws                   Bylaw[]
  bylawViolations          BylawViolation[]

  // Module 6.3 — Enterprise Integrations
  integrationConfigs       IntegrationConfig[]
  integrationSyncLogs      IntegrationSyncLog[]
  integrationEntityMaps    IntegrationEntityMap[]
  webhookEndpoints         WebhookEndpoint[]
  webhookDeliveries        WebhookDelivery[]
  apiKeys                  ApiKey[]
  biReports                BiReport[]
  bmsDevices               BmsDevice[]
  bmsReadings              BmsReading[]

  // Relations — Company Sequences (Phase 2 Cross-Cutting)
  companySequences         CompanySequence[]

  // Relations — AP (Module 3.3)
  apInvoices               ApInvoice[]
  paymentVouchers          PaymentVoucher[]
  expenses                 Expense[]

  @@index([parentId])
  @@map("companies")
}

// ─────────────────────────────────────────────
// COMPANY SEQUENCES — per-company sequential counters
// ─────────────────────────────────────────────

model CompanySequence {
  companyId   String   @map("company_id") @db.Uuid
  sequenceKey String   @map("sequence_key") @db.VarChar(50)
  prefix      String?  @db.VarChar(20)
  currentVal  BigInt   @default(0) @map("current_val")
  padLength   Int      @default(5) @map("pad_length") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, sequenceKey])
  @@map("company_sequences")
}

// ─────────────────────────────────────────────
// AUTH SCHEMA
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  email               String    @db.VarChar(255)
  emailVerified       Boolean   @default(false) @map("email_verified")
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  isLocked            Boolean   @default(false) @map("is_locked")
  lockedAt            DateTime? @map("locked_at") @db.Timestamptz
  lockedReason        String?   @map("locked_reason") @db.VarChar(255)
  failedAttempts      Int       @default(0) @map("failed_attempts") @db.SmallInt
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes      String[]  @map("mfa_backup_codes")
  passwordChangedAt   DateTime? @default(now()) @map("password_changed_at") @db.Timestamptz
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  // Relations — Auth (Module 1.1)
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  devices             UserDevice[]
  passwordHistory     PasswordHistory[]
  authAuditLogs       AuthAuditLog[]        @relation("UserAuditLogs")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  createdIpPolicies   IpPolicy[]            @relation("IpPolicyCreator")
  userIpPolicies      IpPolicy[]            @relation("IpPolicyUser")

  // Relations — User & Role (Module 1.2)
  profile             UserProfile?
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[] @relation("UserOverrides")
  grantedOverrides    UserPermissionOverride[] @relation("OverrideGrantor")
  managedDepartments  Department[]            @relation("DepartmentManager")
  createdRoles        Role[]                  @relation("RoleCreator")
  grantedRolePerms    RolePermission[]        @relation("RolePermGrantor")
  grantedUserRoles    UserRole[]              @relation("UserRoleGrantor")
  sentInvitations     UserInvitation[]        @relation("InvitationSender")

  // Relations — Organization (Module 1.3)
  managedBranches     Branch[]                @relation("BranchManager")
  managedRegions      Region[]                @relation("RegionManager")
  managedBusinessUnits BusinessUnit[]          @relation("BusinessUnitManager")

  // Relations — Workflow (Module 1.4)
  createdDefinitions  WorkflowDefinition[]    @relation("WfDefinitionCreator")
  initiatedInstances  WorkflowInstance[]      @relation("WfInstanceInitiator")
  assignedTasks       WorkflowTask[]          @relation("WfTaskAssignee")
  delegatedTasks      WorkflowTask[]          @relation("WfTaskDelegatee")
  completedTasks      WorkflowTask[]          @relation("WfTaskCompleter")
  escalatedToTasks    WorkflowTask[]          @relation("WfTaskEscalator")
  wfHistoryActions    WorkflowHistory[]       @relation("WfHistoryPerformer")

  // Relations — Notifications (Module 1.5)
  notificationLogs       NotificationLog[]       @relation("NotificationRecipient")
  inAppNotifications     InAppNotification[]     @relation("InAppNotifications")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferences")
  pushDeviceTokens       PushDeviceToken[]       @relation("PushDeviceTokens")
  scheduledNotifications ScheduledNotification[] @relation("ScheduledNotificationCreator")

  // Relations — SSO
  ssoIdentities          SsoIdentity[]           @relation("UserSsoIdentities")

  // Relations — Documents (Module 1.6)
  uploadedDocuments      Document[]              @relation("DocumentUploader")
  uploadedVersions       DocumentVersion[]       @relation("VersionUploader")
  documentAccessLogs     DocumentAccessLog[]     @relation("DocumentAccessor")
  documentShares         DocumentShare[]         @relation("ShareCreator")

  // Relations — Dashboard (Module 1.7)
  dashboardLayouts       DashboardLayout[]       @relation("UserDashboardLayouts")
  savedReports           SavedReport[]           @relation("ReportCreator")

  // Relations — Properties (Module 2.1)
  managedProperties      Property[]              @relation("PropertyManager")
  uploadedPhotos         PropertyPhoto[]         @relation("PhotoUploader")
  propertyStatusChanges  PropertyStatusHistory[] @relation("StatusChanger")

  // Relations — Units (Module 2.2)
  unitStatusChanges      UnitStatusHistory[]     @relation("UnitStatusChanger")

  // Relations — Tenants (Module 2.3)
  kycVerifications       Tenant[]                @relation("KycVerifier")
  tenantBlacklists       Tenant[]                @relation("TenantBlacklister")
  kycReviews             TenantKycDocument[]     @relation("KycReviewer")
  blacklistActions       TenantBlacklistLog[]    @relation("BlacklistActioner")
  tenantNotesAuthored    TenantNote[]            @relation("TenantNoteAuthor")

  // Relations — Leases (Module 2.4)
  leasesCreated          Lease[]                 @relation("LeaseCreator")
  leasesApproved         Lease[]                 @relation("LeaseApprover")
  leaseTemplatesCreated  LeaseTemplate[]         @relation("LeaseTemplateCreator")
  amendmentsApproved     LeaseAmendment[]        @relation("AmendmentApprover")
  amendmentsCreated      LeaseAmendment[]        @relation("AmendmentCreator")
  leaseClausesCreated    LeaseClause[]           @relation("LeaseClauseCreator")

  // Relations — CRM (Module 2.5)
  assignedLeads          Lead[]                  @relation("LeadAgent")
  leadViewingsAgent      LeadViewing[]           @relation("ViewingAgent")
  leadActivitiesPerformed LeadActivity[]          @relation("ActivityPerformer")
  campaignsCreated       MarketingCampaign[]     @relation("CampaignCreator")
  leadBlacklists         Lead[]                  @relation("LeadBlacklister")

  // Relations — Parking (Module 2.6)
  parkingAllocationsCreated ParkingAllocation[]   @relation("AllocationCreator")
  visitorPassesIssued       VisitorParkingPass[]  @relation("PassIssuer")

  // Relations — AR (Module 3.2)
  receiptsCreated            Receipt[]             @relation("ReceiptCreator")
  refundsApproved            RefundRequest[]       @relation("RefundApprover")
  refundsCreated             RefundRequest[]       @relation("RefundCreator")

  // Relations — AP (Module 3.3)
  apInvoicesCreated          ApInvoice[]           @relation("ApInvoiceCreator")
  apInvoicesApproved         ApInvoice[]           @relation("ApInvoiceApprover")
  paymentVouchersCreated     PaymentVoucher[]      @relation("PvCreator")
  paymentVouchersApproved    PaymentVoucher[]      @relation("PvApprover")
  expensesSubmitted          Expense[]             @relation("ExpenseSubmitter")
  expensesApproved           Expense[]             @relation("ExpenseApprover")

  // Relations — Maintenance (Module 4.1)
  technicianProfile          TechnicianProfile?
  ticketsReportedByUser      MaintenanceTicket[]   @relation("TicketReportedByUser")
  ticketsAssignedTo          MaintenanceTicket[]   @relation("TicketAssignedTo")
  ticketsEscalatedTo         MaintenanceTicket[]   @relation("TicketEscalatedTo")
  ticketsResolvedBy          MaintenanceTicket[]   @relation("TicketResolvedBy")
  workOrdersAssigned         WorkOrder[]           @relation("WoAssignedTo")
  ticketPhotosUploaded       TicketPhoto[]         @relation("PhotoUploader")
  slaEscalationContact       MaintenanceSlaConfig[] @relation("SlaEscalationContact")
  slaBreachEscalatedTo       SlaBreachEvent[]      @relation("BreachEscalatedTo")
  pmSchedulesAssigned        PmSchedule[]          @relation("PmAssignedTo")
  pmSchedulesCreated         PmSchedule[]          @relation("PmCreatedBy")
  pmWorkOrdersCompleted      PmWorkOrder[]         @relation("PmWoCompletedBy")
  facilityAssetsResponsible  FacilityAsset[]        @relation("AssetResponsiblePerson")
  camCostEntriesCreated      CamCostEntry[]         @relation("CamCostCreatedBy")

  // Relations — Inventory (Module 4.4)
  stockMovementsPerformed    StockMovement[]        @relation("MovementPerformedBy")
  purchaseReqsCreated        PurchaseRequisition[]  @relation("PrRequestedBy")
  purchaseReqsApproved       PurchaseRequisition[]  @relation("PrApprovedBy")

  // Relations — Housekeeping (Module 4.5)
  cleaningSchedulesAssigned  CleaningSchedule[]     @relation("CleaningAssignedTo")
  cleaningTasksAssigned      CleaningTask[]         @relation("CleaningTaskAssigned")
  inspectionsPerformed       HousekeepingInspection[] @relation("InspectedBy")

  // Relations — Security (Module 4.6)
  incidentsReported          SecurityIncident[]     @relation("IncidentReportedBy")
  incidentsAssigned          SecurityIncident[]     @relation("IncidentAssignedTo")
  patrolSchedulesAssigned    PatrolSchedule[]       @relation("PatrolAssignedTo")
  patrolLogsGuard            PatrolLog[]            @relation("PatrolGuard")

  // Relations — Portal (Module 5.1)
  residents                  Resident[]             @relation("ResidentUser")
  portalSessions             PortalSession[]        @relation("PortalSessionUser")
  issuedAccessCards          ResidentAccessCard[]   @relation("AccessCardIssuer")

  // Relations — Visitors/Booking/Community (Module 5.2-5.4)
  visitorsHosted             Visitor[]              @relation("VisitorHost")
  visitorsCheckedIn          Visitor[]              @relation("VisitorCheckInGuard")
  walkinResponses            WalkinApproval[]       @relation("WalkinResponder")
  blacklistEntriesAdded      VisitorBlacklist[]     @relation("BlacklistAddedBy")
  bookingsApproved           FacilityBooking[]      @relation("BookingApprover")
  blackoutDatesCreated       BookingBlackoutDate[]  @relation("BlackoutCreator")
  announcementsCreated       Announcement[]         @relation("AnnouncementCreator")
  announcementReads          AnnouncementRead[]     @relation("AnnouncementReader")
  pollsCreated               Poll[]                 @relation("PollCreator")
  pollVotes                  PollVote[]             @relation("PollVoter")
  complaintsSubmitted        CommunityComplaint[]   @relation("ComplaintSubmitter")
  complaintsResponded        CommunityComplaint[]   @relation("ComplaintResponder")
  moveRequestsInspected      MoveRequest[]          @relation("MoveInspector")
  moveRequestsApproved       MoveRequest[]          @relation("MoveApprover")

  // Relations — Mall (Module 6.1)
  gtoSubmissionsCreated      GtoSubmission[]        @relation("GtoSubmitter")
  gtoSubmissionsVerified     GtoSubmission[]        @relation("GtoVerifier")
  mallEventsCreated          MallEvent[]            @relation("EventCreator")

  // Relations — Condo (Module 6.2)
  fundTransactionsCreated    FundTransaction[]      @relation("FundTxnCreator")
  fundTransactionsApproved   FundTransaction[]      @relation("FundTxnApprover")
  meetingsCreated            GeneralMeeting[]       @relation("MeetingCreator")
  meetingVotesCast           MeetingVote[]          @relation("VoteCaster")
  bylawsCreated              Bylaw[]                @relation("BylawCreator")
  violationsReported         BylawViolation[]       @relation("ViolationReporter")

  // Relations — Enterprise Integrations (Module 6.3)
  integrationsCreated        IntegrationConfig[]    @relation("IntegrationCreator")
  syncsInitiated             IntegrationSyncLog[]   @relation("SyncInitiator")
  webhooksCreated            WebhookEndpoint[]      @relation("WebhookCreator")
  apiKeysCreated             ApiKey[]               @relation("ApiKeyCreator")
  biReportsCreated           BiReport[]             @relation("BiReportCreator")

  // Relations — Integrations (Google Calendar, etc.)
  integrations               UserIntegration[]      @relation("UserIntegrations")

  @@unique([email, companyId], name: "uq_users_email_company")
  @@index([email])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  family       String    @db.VarChar(255)
  deviceId     String?   @map("device_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason") @db.VarChar(100)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([family])
  @@map("refresh_tokens")
}

model UserIntegration {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.VarChar(50)  // e.g. "google_calendar"
  accessToken  String    @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  tokenExpiry  DateTime? @map("token_expiry") @db.Timestamptz
  scope        String?   @db.VarChar(500)
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user         User      @relation("UserIntegrations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], name: "uq_user_integration")
  @@map("user_integrations")
}

model UserDevice {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceName   String?   @map("device_name") @db.VarChar(255)
  deviceType   String?   @map("device_type") @db.VarChar(50)
  os           String?   @db.VarChar(100)
  browser      String?   @db.VarChar(100)
  fingerprint  String    @db.VarChar(255)
  isTrusted    Boolean   @default(false) @map("is_trusted")
  trustedAt    DateTime? @map("trusted_at") @db.Timestamptz
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz
  lastIp       String?   @map("last_ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fingerprint, userId], name: "uq_device_fingerprint_user")
  @@map("user_devices")
}

model IpPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  policyType  String   @map("policy_type") @db.VarChar(10)
  cidr        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?    @relation("IpPolicyUser", fields: [userId], references: [id], onDelete: Cascade)
  creator     User?    @relation("IpPolicyCreator", fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("ip_policies")
}

model PasswordPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @unique @map("company_id") @db.Uuid
  minLength            Int      @default(8) @map("min_length") @db.SmallInt
  requireUppercase     Boolean  @default(true) @map("require_uppercase")
  requireLowercase     Boolean  @default(true) @map("require_lowercase")
  requireNumber        Boolean  @default(true) @map("require_number")
  requireSpecial       Boolean  @default(true) @map("require_special")
  maxAgeDays           Int?     @default(90) @map("max_age_days") @db.SmallInt
  historyCount         Int      @default(5) @map("history_count") @db.SmallInt
  maxFailedAttempts    Int      @default(5) @map("max_failed_attempts") @db.SmallInt
  lockoutDurationMins  Int      @default(30) @map("lockout_duration_mins") @db.SmallInt
  sessionTimeoutMins   Int      @default(480) @map("session_timeout_mins") @db.SmallInt
  mfaRequired          Boolean  @default(false) @map("mfa_required")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("password_policies")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model AuthAuditLog {
