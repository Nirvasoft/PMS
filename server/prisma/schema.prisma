  id             String    @id @default(uuid()) @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  deviceName     String    @map("device_name") @db.VarChar(150)
  deviceType     String    @map("device_type") @db.VarChar(50)   // hvac|elevator|fire_panel|power_meter|water_meter
  protocol       String    @db.VarChar(20)                       // bacnet_ip|bacnet_mstp|modbus_tcp|lonworks
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  port           Int?
  bacnetDeviceId Int?      @map("bacnet_device_id")
  isActive       Boolean   @default(true) @map("is_active")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz
  faultActive    Boolean   @default(false) @map("fault_active")
  faultMessage   String?   @map("fault_message")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  property       Property  @relation(fields: [propertyId], references: [id])
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  readings       BmsReading[]

  @@index([propertyId])
  @@index([companyId])
  @@map("bms_devices")
}

model BmsReading {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  pointName   String   @map("point_name") @db.VarChar(100)    // BACnet object name or Modbus register label
  pointType   String   @map("point_type") @db.VarChar(30)     // analog_input|binary_input|analog_value
  value       Decimal? @db.Decimal(16, 6)
  unit        String?  @db.VarChar(30)
  quality     String   @default("good") @db.VarChar(20)       // good|bad|uncertain
  readAt      DateTime @default(now()) @map("read_at") @db.Timestamptz

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device      BmsDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, readAt(sort: Desc)])
  @@map("bms_readings")
}

// ─────────────────────────────────────────────
// MODULE 3.3 — ACCOUNTS PAYABLE
// ─────────────────────────────────────────────

model ApInvoice {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  propertyId          String?   @map("property_id") @db.Uuid
  vendorName          String    @map("vendor_name") @db.VarChar(255)
  vendorInvoiceNo     String?   @map("vendor_invoice_no") @db.VarChar(100)
  apInvoiceNumber     String    @unique @map("ap_invoice_number") @db.VarChar(50)
  invoiceDate         DateTime  @map("invoice_date") @db.Date
  dueDate             DateTime  @map("due_date") @db.Date
  description         String?   @db.Text
  subtotal            Decimal   @db.Decimal(15, 2)
  taxAmount           Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(15, 2)
  paidAmount          Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2)
  currency            String    @default("USD") @db.VarChar(3)
  status              String    @default("pending") @db.VarChar(20)
  costCenter          String?   @map("cost_center") @db.VarChar(100)
  departmentId        String?   @map("department_id") @db.Uuid
  poReference         String?   @map("po_reference") @db.VarChar(100)
  approvedBy          String?   @map("approved_by") @db.Uuid
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz
  rejectionReason     String?   @map("rejection_reason") @db.Text
  glPosted            Boolean   @default(false) @map("gl_posted")
  glJournalId         String?   @map("gl_journal_id") @db.Uuid
  attachmentUrl       String?   @map("attachment_url") @db.VarChar(500)
  notes               String?   @db.Text
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property            Property? @relation(fields: [propertyId], references: [id])
  department          Department? @relation(fields: [departmentId], references: [id])
  approver            User?     @relation("ApInvoiceApprover", fields: [approvedBy], references: [id])
  creator             User      @relation("ApInvoiceCreator", fields: [createdBy], references: [id])
  lines               ApInvoiceLine[]
  pvAllocations       PvAllocation[]

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("ap_invoices")
}

model ApInvoiceLine {
  id              String   @id @default(uuid()) @db.Uuid
  apInvoiceId     String   @map("ap_invoice_id") @db.Uuid
  chargeTypeId    String?  @map("charge_type_id") @db.Uuid
  description     String   @db.VarChar(500)
  quantity        Decimal  @default(1) @db.Decimal(10, 4)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(15, 4)
  amount          Decimal  @db.Decimal(15, 2)
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(15, 2)
  glAccountCode   String?  @map("gl_account_code") @db.VarChar(20)
  sortOrder       Int      @default(0) @map("sort_order") @db.SmallInt

  apInvoice       ApInvoice  @relation(fields: [apInvoiceId], references: [id], onDelete: Cascade)
  chargeType      ChargeType? @relation(fields: [chargeTypeId], references: [id])

  @@index([apInvoiceId])
  @@map("ap_invoice_lines")
}

model PaymentVoucher {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  voucherNumber     String    @unique @map("voucher_number") @db.VarChar(50)
  voucherDate       DateTime  @map("voucher_date") @db.Date
  paymentMethod     String    @map("payment_method") @db.VarChar(30)
  bankAccountId     String?   @map("bank_account_id") @db.Uuid
  vendorName        String    @map("vendor_name") @db.VarChar(255)
  vendorBankName    String?   @map("vendor_bank_name") @db.VarChar(100)
  vendorBankAcc     String?   @map("vendor_bank_acc") @db.VarChar(50)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(15, 2)
  currency          String    @db.VarChar(3)
  paymentReference  String?   @map("payment_reference") @db.VarChar(255)
  status            String    @default("pending") @db.VarChar(20)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz
  approvedBy        String?   @map("approved_by") @db.Uuid
  glPosted          Boolean   @default(false) @map("gl_posted")
  glJournalId       String?   @map("gl_journal_id") @db.Uuid
  notes             String?   @db.Text
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount? @relation(fields: [bankAccountId], references: [id])
  approver          User?        @relation("PvApprover", fields: [approvedBy], references: [id])
  creator           User         @relation("PvCreator", fields: [createdBy], references: [id])
  allocations       PvAllocation[]

  @@index([companyId])
  @@index([status])
  @@map("payment_vouchers")
}

model PvAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  voucherId     String   @map("voucher_id") @db.Uuid
  apInvoiceId   String   @map("ap_invoice_id") @db.Uuid
  amount        Decimal  @db.Decimal(15, 2)

  voucher       PaymentVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  apInvoice     ApInvoice      @relation(fields: [apInvoiceId], references: [id])

  @@unique([voucherId, apInvoiceId])
  @@map("pv_allocations")
}

model Expense {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  propertyId      String?   @map("property_id") @db.Uuid
  departmentId    String?   @map("department_id") @db.Uuid
  expenseDate     DateTime  @map("expense_date") @db.Date
  category        String    @db.VarChar(100)
  description     String    @db.Text
  amount          Decimal   @db.Decimal(15, 2)
  currency        String    @db.VarChar(3)
  receiptUrl      String?   @map("receipt_url") @db.VarChar(500)
  submittedBy     String    @map("submitted_by") @db.Uuid
  status          String    @default("pending") @db.VarChar(20)
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  glAccountCode   String?   @map("gl_account_code") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property        Property?   @relation(fields: [propertyId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  submitter       User        @relation("ExpenseSubmitter", fields: [submittedBy], references: [id])
  approver        User?       @relation("ExpenseApprover", fields: [approvedBy], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("expenses")
}


