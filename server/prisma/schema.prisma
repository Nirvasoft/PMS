  leaseId         String    @map("lease_id") @db.Uuid
  amendmentNumber Int       @map("amendment_number") @db.SmallInt
  amendmentType   String    @map("amendment_type") @db.VarChar(50)
  description     String    @db.Text
  effectiveDate   DateTime  @map("effective_date") @db.Date
  newRentAmount   Decimal?  @map("new_rent_amount") @db.Decimal(15, 2)
  newEndDate      DateTime? @map("new_end_date") @db.Date
  newUnitId       String?   @map("new_unit_id") @db.Uuid
  oldValues       Json      @default("{}") @map("old_values")
  newValues       Json      @default("{}") @map("new_values")
  status          String    @default("pending_approval") @db.VarChar(20)
