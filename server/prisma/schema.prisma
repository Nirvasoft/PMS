model Lead {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  propertyId        String?   @map("property_id") @db.Uuid
  leadNumber        String?   @map("lead_number") @db.VarChar(30)
  // Contact info
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  companyName       String?   @map("company_name") @db.VarChar(255)
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  mobile            String?   @db.VarChar(50)
  // Requirements
  unitTypePreference String?  @map("unit_type_preference") @db.VarChar(50)
  minAreaSqft       Decimal?  @map("min_area_sqft") @db.Decimal(10, 2)
  maxAreaSqft       Decimal?  @map("max_area_sqft") @db.Decimal(10, 2)
  moveInDate        DateTime? @map("move_in_date") @db.Date
  budgetMin         Decimal?  @map("budget_min") @db.Decimal(15, 2)
  budgetMax         Decimal?  @map("budget_max") @db.Decimal(15, 2)
  leaseTermMonths   Int?      @map("lease_term_months") @db.SmallInt
  // Pipeline
  stage             String    @default("new") @db.VarChar(30)
  priority          String    @default("medium") @db.VarChar(10)
  source            String?   @db.VarChar(50)
  campaignId        String?   @map("campaign_id") @db.Uuid
  assignedTo        String?   @map("assigned_to") @db.Uuid
  lostReason        String?   @map("lost_reason") @db.VarChar(255)
  lostAt            DateTime? @map("lost_at") @db.Timestamptz
  convertedAt       DateTime? @map("converted_at") @db.Timestamptz
  convertedLeaseId  String?   @map("converted_lease_id") @db.Uuid
  convertedTenantId String?   @map("converted_tenant_id") @db.Uuid
  notes             String?   @db.Text
  tags              String[]  @default([])
  // Blacklist
  isBlacklisted     Boolean   @default(false) @map("is_blacklisted")
  blacklistedAt     DateTime? @map("blacklisted_at") @db.Timestamptz
  blacklistedBy     String?   @map("blacklisted_by") @db.Uuid
  blacklistReason   String?   @map("blacklist_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property          Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  campaign          MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agent             User?     @relation("LeadAgent", fields: [assignedTo], references: [id], onDelete: SetNull)
  convertedLease    Lease?    @relation("ConvertedLease", fields: [convertedLeaseId], references: [id], onDelete: SetNull)
  convertedTenant   Tenant?   @relation("ConvertedTenant", fields: [convertedTenantId], references: [id], onDelete: SetNull)
  viewings          LeadViewing[]
  activities        LeadActivity[]
  blacklister       User?     @relation("LeadBlacklister", fields: [blacklistedBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([stage])
  @@index([assignedTo])
  @@index([isBlacklisted])
  @@map("leads")
}

model LeadViewing {
  id               String    @id @default(uuid()) @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  unitId           String?   @map("unit_id") @db.Uuid
  propertyId       String?   @map("property_id") @db.Uuid
