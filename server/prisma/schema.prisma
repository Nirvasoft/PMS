  slotType        String    @default("car") @map("slot_type") @db.VarChar(20)
  size            String    @default("standard") @db.VarChar(20)
  hasEvCharger    Boolean   @default(false) @map("has_ev_charger")
  evChargerType   String?   @map("ev_charger_type") @db.VarChar(30)
  status          String    @default("available") @db.VarChar(20)
  monthlyRate     Decimal?  @map("monthly_rate") @db.Decimal(10, 2)
  hourlyRate      Decimal?  @map("hourly_rate") @db.Decimal(8, 2)
