  property         Property? @relation("ViewingProperty", fields: [propertyId], references: [id], onDelete: SetNull)
  agent            User?     @relation("ViewingAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([scheduledAt])
  @@map("lead_viewings")
}

model MarketingCampaign {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
