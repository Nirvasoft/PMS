# ═══════════════════════════════════════════════════════════════
# PMS Server — Environment Variables
# Copy this file to .env and fill in your values.
# Generate secrets with: openssl rand -hex 64
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pms_dev?schema=public"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX="pms:"

# ─── JWT ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET="change-me-to-a-256-bit-random-hex-in-production"
JWT_ACCESS_EXPIRY=900         # seconds (15m)
JWT_REFRESH_EXPIRY=86400      # seconds (1d)
JWT_REFRESH_EXPIRY_LONG=2592000  # seconds (30d — "remember me")
JWT_MFA_SECRET="change-me-separate-mfa-secret"
JWT_MFA_EXPIRY=300            # seconds (5m)

# ─── Encryption ──────────────────────────────────────────────
# AES-256 key — must be exactly 32 bytes (64 hex chars)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
ENCRYPTION_IV_LENGTH=16

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────
AUTH_RATE_LIMIT_TTL=60        # window in seconds
AUTH_RATE_LIMIT_MAX=10        # max failed attempts per window

# ─── HaveIBeenPwned (Password Breach Check) ──────────────────
HIBP_API_URL=https://api.pwnedpasswords.com
HIBP_CHECK_ENABLED=false      # set true in production

# ─── Email / SMTP (Module 1.5 — Notifications) ───────────────
# Required for: invitations, password reset, notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false             # true for port 465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password   # Gmail: use App Password, not account password
SMTP_FROM="PMS System <no-reply@yourcompany.com>"

# ─── Document Storage (Module 1.6) ───────────────────────────
# Max file upload size in bytes (default: 500 MB)
MAX_UPLOAD_SIZE=524288000
# Local storage path (relative to server/ directory)
UPLOAD_PATH=uploads/documents

# ─── Phase 2: AWS S3 (uncomment when ready) ──────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=pms-documents
# AWS_S3_ENDPOINT=                # for MinIO or other S3-compatible storage

# ─── Phase 2: SSO (uncomment when integrating) ───────────────
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
# SSO_MICROSOFT_CLIENT_ID=
# SSO_MICROSOFT_CLIENT_SECRET=
# SSO_CALLBACK_URL=http://localhost:3000/api/v1/auth/sso/callback
