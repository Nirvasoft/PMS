# ═══════════════════════════════════════════════════════════════
# PMS Client — Environment Variables
# Copy this file to .env and fill in your values.
# All variables MUST be prefixed with VITE_ to be accessible
# in the browser bundle.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── API ─────────────────────────────────────────────────────
# Base URL of the PMS backend server (no trailing slash)
VITE_API_URL=http://localhost:3000/api/v1

# ─── Phase 2: Feature Flags (uncomment when ready) ───────────
# VITE_ENABLE_SSO=false
# VITE_ENABLE_REPORTS_EXPORT=false
# VITE_SENTRY_DSN=
