# ─── Node ────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Environment files (NEVER commit secrets) ─
.env
.env.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local
server/.env
server/.env.local
server/.env.development
server/.env.production
client/.env
client/.env.local
client/.env.development
client/.env.production
# Allow .env.example files — they contain no secrets
!.env.example
!server/.env.example
!client/.env.example

# ─── Build outputs ───────────────────────────
dist/
build/
server/dist/

# ─── Prisma ──────────────────────────────────
# Keep schema.prisma and migrations, ignore generated client
server/node_modules/

# ─── Uploads / Storage ───────────────────────
server/uploads/
!server/uploads/.gitkeep

# ─── OS ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── IDE ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Logs ────────────────────────────────────
*.log
logs/

# ─── Test coverage ───────────────────────────
coverage/
.nyc_output/

# ─── TypeScript ──────────────────────────────
*.tsbuildinfo
